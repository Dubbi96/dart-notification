# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/dart_notification?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-change-in-production"
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# DART API
DART_API_KEY="your-dart-api-key"

# Expo Push Notification
EXPO_PUSH_ACCESS_TOKEN="your-expo-push-access-token"

# App
PORT=3000
NODE_ENV=development
