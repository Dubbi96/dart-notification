# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/dart_notification?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-change-in-production"
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# DART API
DART_API_KEY="your-dart-api-key"

# Expo Push Notification
EXPO_PUSH_ACCESS_TOKEN="your-expo-push-access-token"

# Kakao OAuth (카카오 개발자 콘솔 > 앱 키 > REST API 키)
# - KAKAO_REST_API_KEY: 모바일 EXPO_PUBLIC_KAKAO_REST_API_KEY 와 동일한 앱의 REST API 키
# - KAKAO_CLIENT_SECRET: 카카오 로그인 > 보안 > Client Secret 사용 시에만 (미사용 시 빈 값)
KAKAO_REST_API_KEY="your-kakao-rest-api-key"
KAKAO_CLIENT_SECRET=""

# API Base URL — 카카오 콜백 redirect_uri 매칭에 사용.
# Expo Go(실기기) 테스트 시 개발 PC의 LAN IP 사용 (예: http://192.168.0.17:3000/api)
API_BASE_URL="http://localhost:3000/api"

# App
PORT=3000
NODE_ENV=development

# M1 신규: 공시 원문 파싱 스토리지
STORAGE_DRIVER=local          # 'local' | 's3' (현재 local만 지원)
LOCAL_STORAGE_PATH=./storage  # STORAGE_DRIVER=local 일 때 저장 루트 (상대 경로)
