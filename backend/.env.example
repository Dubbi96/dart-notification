# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/dart_notification?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-change-in-production"
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# DART API
DART_API_KEY="your-dart-api-key"

# KRX 데이터마켓플레이스 (Engine3 시세 수집, M4) — 일봉·지수·종목상태 1차 소스
# KRX_API_KEY 설정 시 DAR-8(KRX 라이브 수집) 할당 가능
KRX_API_KEY="your-krx-api-key"
KRX_BASE_URL="http://data-dbg.krx.co.kr/svc/apis"

# LLM (Engine2 AI Analyst, M3) — OpenAI 호환 Chat Completions
# OpenAI 키면 LLM_API_KEY만, Anthropic 등은 LLM_BASE_URL/LLM_MODEL 함께 지정
LLM_API_KEY="your-llm-api-key"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"

# AI 비용 하드캡 (Engine2 AiCostLimitGuard, W10) — 미설정 시 기본값(일 $1 / 월 $31)
# 월캡 기본 31 = 일캡×31일 정합(월캡이 일평균으로 먼저 바인딩되던 조기 차단 제거)
AI_DAILY_LIMIT_USD=1.0
AI_MONTHLY_LIMIT_USD=31.0

# Redis / BullMQ (엔진 간 이벤트 큐, M3 DAR-5) — 키 아님, 로컬 서버(docker-compose redis)
# 비밀번호 미사용 로컬은 REDIS_PASSWORD 생략
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Expo Push Notification
EXPO_PUSH_ACCESS_TOKEN="your-expo-push-access-token"

# Kakao OAuth (카카오 개발자 콘솔 > 앱 키 > REST API 키)
# - KAKAO_REST_API_KEY: 모바일 EXPO_PUBLIC_KAKAO_REST_API_KEY 와 동일한 앱의 REST API 키
# - KAKAO_CLIENT_SECRET: 카카오 로그인 > 보안 > Client Secret 사용 시에만 (미사용 시 빈 값)
KAKAO_REST_API_KEY="your-kakao-rest-api-key"
KAKAO_CLIENT_SECRET=""

# API Base URL — 카카오 콜백 redirect_uri 매칭에 사용.
# Expo Go(실기기) 테스트 시 개발 PC의 LAN IP 사용 (예: http://192.168.0.17:3000/api)
API_BASE_URL="http://localhost:3000/api"

# App
PORT=3000
NODE_ENV=development

# M1 신규: 공시 원문 파싱 스토리지
STORAGE_DRIVER=local          # 'local' | 's3' (현재 local만 지원)
LOCAL_STORAGE_PATH=./storage  # STORAGE_DRIVER=local 일 때 저장 루트 (상대 경로)

# AOS A3-2 FeatureSnapshot dual-write — reconciliation 전 기본 OFF
AOS_FEATURE_SNAPSHOT_DUAL_WRITE_ENABLED=false
AOS_DECISION_DUAL_WRITE_ENABLED=false
# AOS A5 canonical SHADOW/PAPER dual ledger — versioned RiskPolicy 준비 전 기본 OFF
AOS_CANONICAL_PAPER_LEDGER_ENABLED=false
