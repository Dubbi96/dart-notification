# ─────────────────────────────────────────────────────────────────────────────
# DAR-427 · 운영(production) 환경변수 템플릿 — Oracle Cloud Always Free 배포용
#
# 사용법:
#   1) cp backend/.env.prod.example backend/.env.prod
#   2) 아래 CHANGE_ME_* / your-* 플레이스홀더를 실제 값으로 채운다(발급처는 각 주석 참조).
#   3) docker-compose.prod.yml 의 backend·postgres·redis·migrate 가 이 파일을 env_file 로 읽는다.
#
# ★보안: backend/.env.prod 는 .gitignore 로 커밋 금지. 시크릿 하드코딩 0 — 이 example 만 커밋한다.
# ★강한 시크릿 생성 예: openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# ── 런타임 ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# TZ 는 backend 이미지에 Asia/Seoul 로 고정돼 있음(Dockerfile). 필요 시 재정의.
# TZ=Asia/Seoul

# ── Postgres 컨테이너 자격증명 (docker-compose.prod.yml 의 postgres 서비스가 사용) ──
# ★ DATABASE_URL 의 사용자/비밀번호/DB명과 반드시 일치시켜야 한다.
POSTGRES_USER=dart
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=dart_notification

# ── DB 연결 (boot-critical, required) ────────────────────────────────────────
# host 는 compose 서비스명 'postgres'. 위 POSTGRES_* 와 동일 값으로 채운다.
DATABASE_URL="postgresql://dart:CHANGE_ME_DB_PASSWORD@postgres:5432/dart_notification?schema=public"

# ── Redis / BullMQ (host 는 compose 서비스명 'redis') ─────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# 운영은 비밀번호 설정 권장. 설정 시 redis 컨테이너가 --requirepass 로 기동된다(빈 값이면 비밀번호 없이).
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT (boot-critical, required · 각 최소 16자) ─────────────────────────────
# 생성: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_JWT_SECRET_min16chars
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_min16chars
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# ── DART Open API (boot-critical, required) ──────────────────────────────────
# 발급: https://opendart.fss.or.kr  (인증키 신청/관리)
DART_API_KEY=your-dart-api-key

# ── LLM / Engine2 AI Analyst (boot-critical, required) ───────────────────────
# OpenAI 키면 LLM_API_KEY 만, Anthropic 등 호환 엔드포인트는 BASE_URL/MODEL 함께 지정.
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Kakao OAuth (KAKAO_REST_API_KEY: boot-critical, required) ────────────────
# 발급: 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=your-kakao-rest-api-key
# 카카오 로그인 > 보안 > Client Secret 사용 시에만. 미사용이면 빈 값.
KAKAO_CLIENT_SECRET=

# ── KRX 데이터마켓플레이스 (Engine3 시세 수집 · 선택) ────────────────────────
# 발급: http://data.krx.co.kr  (Open API 신청). 미설정이면 시세 수집 기능만 비활성.
KRX_API_KEY=your-krx-api-key
KRX_BASE_URL=http://data-dbg.krx.co.kr/svc/apis

# ── KIS 한국투자증권 OpenAPI (분봉 단타 실시간 시세 · 선택) ──────────────────
# 발급: 한국투자증권 > KIS Developers. 미설정이면 분봉 라이브 수집만 비활성.
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret
KIS_ACCOUNT_NO=your-kis-account-no
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_REALTIME=false

# ── Expo Push (모바일 푸시 알림 · 선택) ──────────────────────────────────────
# 발급: https://expo.dev > Account > Access Tokens
EXPO_PUSH_ACCESS_TOKEN=your-expo-push-access-token

# ── 공개 API Base URL (카카오 콜백 redirect_uri 매칭) ────────────────────────
# 도메인/공인IP 로 교체. 예: http://<공인IP>:3000/api 또는 https://api.example.com/api
API_BASE_URL=http://your-public-host:3000/api

# ── CORS (운영은 화이트리스트 필수 · 콤마 구분) ──────────────────────────────
# 모바일/웹 클라이언트 origin 만 허용. 미설정이면 운영에서 외부 origin 차단.
CORS_ALLOWED_ORIGINS=https://your-app-domain.com

# ── 객체 스토리지 / S3 (공시 원문·표 오프로드 · DAR-395/399) ─────────────────
# 운영 권장: STORAGE_DRIVER=s3. 미설정/자격증명 부재 시 로컬 파일로 graceful 폴백(비차단).
# S3 활성화 시 backend 이미지에 SDK 필요: 컨테이너 빌드 전 package.json 에
#   @aws-sdk/client-s3 를 추가하거나, npm i @aws-sdk/client-s3 --legacy-peer-deps 로 설치.
STORAGE_DRIVER=s3
AWS_REGION=ap-northeast-2
S3_BUCKET=your-s3-bucket
# 자격증명 미지정 시 SDK 기본 자격증명 체인(IAM 역할/인스턴스 프로파일) 사용.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# (선택) 공유 버킷 환경 분리 prefix
S3_PREFIX=prod
# (선택) S3 호환 스토리지(MinIO 등) 커스텀 엔드포인트 + path-style
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# 로컬 폴백 시 저장 루트(STORAGE_DRIVER=local 일 때만 의미)
LOCAL_STORAGE_PATH=./storage
