// ====================================
// DAR-109: 신호→진입 퍼널 일별 계측 (engine5 모의운용)
//
// 졸업 표본(G1/G2/G5)을 막던 PrismaSimulationAdapter write 실구현과 함께,
// '당일 생성 신호 수 → 진입 후보 통과 수 → 실제 체결 수'를 일별로 누적 기록한다.
// fill/adoption rate(체결률·채택률)는 read 시 파생 산출(저장하지 않음 — 단일 출처).
// ★ 모의 전용 — 실주문 무관. AI 미개입(순수 카운트). 멱등키 (portfolioId, tradeDate).
// ====================================
model SignalEntryFunnelDaily {
  id          String @id @default(cuid())
  portfolioId String
  tradeDate   String // 거래일 (YYYYMMDD)

  signalsGenerated Int // 당일 생성된 매수 신호 수 (퍼널 최상단)
  candidatesPassed Int // 진입 후보 선정(보유중복·슬롯 필터) 통과 수
  filled           Int // 실제 모의 체결(신규 매수) 수

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, tradeDate])
  @@index([portfolioId, tradeDate])
  @@map("signal_entry_funnel_daily")
}

// ====================================
// DAR-479 [견고화 W0·P04]: 백테스트 vs forward 성과 괴리 일일 스냅샷 (engine5 read-only 측정)
//
// 리플레이 트랙(BacktestRun.strategyKey, 과거 1년 재생)과 forward 트랙(styleTag='strategy:<key>',
// 오늘 신호→오늘 진입 누적)을 strategyKey 로 조인한 괴리(수익률·승률·거래빈도·보유기간)를
// 추세 추적용으로 매일 1행 적재한다. SignalEntryFunnelDaily 스냅샷 패턴 계승 —
// 멱등키 (strategyKey, snapshotDate), 자연 그룹핑 키(strategyKey)는 인덱스만(FK 관계 없음).
// ★ 측정·적재 전용 — 트레이딩 행동 무접촉(매수·체결·청산 경로 무변경). AI 미개입(순수 산술).
//   표본 부족(기존 임계 미달)은 lowSample=true 로 정직 표기.
// ====================================
model BacktestForwardDivergenceSnapshot {
  id           String @id @default(cuid())
  strategyKey  String // 전략 변형 키 (event-edge / short-momentum / conservative-value / aggressive-diversified)
  snapshotDate String // 거래일 (YYYYMMDD, KST)

  // 백테스트(리플레이) 기준값 — BacktestRun.summary.metrics
  backtestReturnPct      Float? // 누적 수익률(%). 트랙 미산출이면 null
  backtestWinRate        Float? // 승률(0~1). 표본 0이면 null
  backtestTradeCount     Int    @default(0) // 청산 완료 트레이드 수(표본)
  backtestAvgHoldDays    Float? // 평균 보유일수. 표본 0이면 null
  backtestTradesPerMonth Float? // 30일 환산 거래빈도. 산출불가 null

  // forward 실운용 누적값 — 전략 forward 포트폴리오 성적표
  forwardReturnPct      Float? // 누적 수익률(%). 표본 0이면 null
  forwardWinRate        Float? // 승률(0~1). 표본 0이면 null
  forwardTradeCount     Int    @default(0) // 청산 완료 트레이드 수(표본)
  forwardAvgHoldDays    Float? // 평균 보유일수. 표본 0이면 null
  forwardTradesPerMonth Float? // 30일 환산 거래빈도. 산출불가 null

  // 괴리 = forward - backtest (양쪽 산출 가능할 때만; 아니면 null)
  returnGapPct Float? // 수익률 괴리(%p)
  winRateGap   Float? // 승률 괴리(0~1 차)
  tradeFreqGap Float? // 거래빈도 괴리(월 환산 건수 차)
  holdDaysGap  Float? // 보유기간 괴리(일 차)

  // 표본 부족 정직 표기(백테스트 또는 forward 표본이 기존 임계 미만)
  lowSample Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([strategyKey, snapshotDate])
  @@index([strategyKey, snapshotDate])
  @@map("backtest_forward_divergence_snapshots")
}

// ====================================
// M9-A: 백테스트 엔진 (DAR-13)
// AI 금지영역: 백테스트 로직·체결 시뮬은 순수 Rule. AI 개입 0.
// ====================================

enum BacktestStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ExitReason {
  TAKE_PROFIT
  STOP_LOSS
  TRAILING_STOP
  THESIS_BREAK
  MAX_HOLD_DAYS
  CHART_BREAK
  LIQUIDITY_EXIT
  FORCE_EXIT
  // DAR-486: 상폐(가격 소멸) 확정 감액 청산 — 백테스트 생존편향 처리 옵션 활성 시에만 발생.
  DELISTED
}

model BacktestRun {
  id          String  @id @default(cuid())
  name        String
  description String?

  // DAR-404: 트레이딩 로직(전략 변형) 식별 키. 다중 트랙 비교/거래내역 조회의 자연 그룹핑 키.
  //   라이브 1년 리플레이(DAR-385, 단일 트랙)는 NULL 로 남아 기존 동작과 격리된다.
  strategyKey String?

  // 전략 파라미터 JSON
  strategyParams Json

  // 테스트 기간
  startDate DateTime
  endDate   DateTime
  universe  String // "WATCHLIST" | "KOSPI200" | "ALL_LISTED"

  // 비용 파라미터
  commissionRate Decimal @db.Decimal(6, 5)
  taxRate        Decimal @db.Decimal(6, 5)
  slippagePct    Decimal @db.Decimal(6, 5)

  // 실행 상태
  status       BacktestStatus @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?

  // 성과 요약 (완료 후 저장)
  summary Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trades BacktestTrade[]

  @@index([status])
  @@index([startDate, endDate])
  @@index([strategyKey])
  @@map("backtest_runs")
}

model BacktestTrade {
  id            String @id @default(cuid())
  backtestRunId String

  // 공시 연결 (lookahead bias 방지: rcpDt 기준 진입만 허용)
  disclosureRcpNo String // FK → Disclosure.rcpNo
  corpCode        String // FK → Company.corpCode
  stockCode       String

  eventType String
  persona   String

  // 진입 (다음 거래일 시가 진입 — lookahead bias 방지 핵심)
  disclosureAt  DateTime // 공시 실제 접수 시각
  isAfterMarket Boolean // 장마감(15:30) 후 공시 여부
  entryDate     DateTime // 실제 진입 거래일
  entryPrice    Decimal  @db.Decimal(12, 2)
  entryShares   Int
  entryValue    Decimal  @db.Decimal(16, 2)

  // 매도
  exitDate   DateTime?
  exitPrice  Decimal?    @db.Decimal(12, 2)
  exitShares Int?
  exitValue  Decimal?    @db.Decimal(16, 2)
  exitReason ExitReason?

  // 비용
  commission Decimal @default(0) @db.Decimal(12, 2)
  tax        Decimal @default(0) @db.Decimal(12, 2)
  slippage   Decimal @default(0) @db.Decimal(12, 2)

  // 성과
  grossPnl  Decimal? @db.Decimal(12, 2)
  netPnl    Decimal? @db.Decimal(12, 2)
  returnPct Decimal? @db.Decimal(8, 4)
  holdDays  Int?

  // 현실 제약 플래그
  wasLimitUp          Boolean  @default(false)
  wasLimitDown        Boolean  @default(false)
  wasTradingSuspended Boolean  @default(false)
  wasAdminStock       Boolean  @default(false)
  isPartialFill       Boolean  @default(false)
  fillRate            Decimal? @db.Decimal(5, 4)
  lowLiquidityFlag    Boolean  @default(false)

  // 진입 시점 점수 스냅샷
  buyScoreSnapshot  Int?
  exitScoreSnapshot Int?

  createdAt DateTime @default(now())

  backtestRun BacktestRun @relation(fields: [backtestRunId], references: [id], onDelete: Cascade)

  @@index([backtestRunId])
  @@index([corpCode])
  @@index([eventType])
  @@index([persona])
  @@index([entryDate])
  @@index([returnPct])
  @@map("backtest_trades")
}

// ====================================
// M10 — Engine5 Paper Trade (DAR-16)
// AI 금지영역: 체결·Risk 로직 순수 Rule. AI 개입 0.
// ====================================

enum PaperTradeStatus {
  PENDING // 주문 대기
  FILLED // 완전 체결
  PARTIAL // 부분 체결
  CANCELLED // 취소
  REJECTED // 거부 (Risk 한도 초과)
}

enum PaperTradeDirection {
  BUY
  SELL
}

model PaperTrade {
  id String @id @default(cuid())

  // 종목 (FK → Company.corpCode)
  corpCode  String
  stockCode String

  // 방향·수량
  direction     PaperTradeDirection
  orderedShares Int // 주문 수량
  filledShares  Int                 @default(0) // 체결 수량
  fillRate      Decimal             @default(0) @db.Decimal(5, 4) // 체결률 0~1

  // 가격
  entryPrice  Decimal  @db.Decimal(12, 2) // 진입 기준가 (다음거래일 시가)
  filledPrice Decimal? @db.Decimal(12, 2) // 실제 체결가 (슬리피지 반영)

  // DAR-474: 신호시점 기대가(예약 시점 기준가). 체결기(fillPendingEntries)가 entryPrice를
  //   체결일 시가로 덮어써도 신호→체결 슬리피지 측정을 위해 보존한다.
  //   ★측정 표면 전용(additive nullable) — 체결 로직/가격 시맨틱 무변경. 레거시 행은 null(graceful).
  expectedPrice Decimal? @db.Decimal(12, 2)

  // 비용 (KRW 절대값)
  commission Decimal @default(0) @db.Decimal(12, 2) // 수수료
  tax        Decimal @default(0) @db.Decimal(12, 2) // 세금 (매도 시 증권거래세)
  slippage   Decimal @default(0) @db.Decimal(12, 2) // 슬리피지 비용

  // 손익 (체결 완료 후)
  grossPnl  Decimal? @db.Decimal(12, 2)
  netPnl    Decimal? @db.Decimal(12, 2)
  returnPct Decimal? @db.Decimal(8, 4)

  // 상태
  status PaperTradeStatus @default(PENDING)

  // 메타
  entryDate DateTime // 체결 예정 거래일 (다음거래일 시가 진입)
  filledAt  DateTime? // 실제 체결 시각

  // 신호·논리 연결 (optional — fixture 테스트에서는 null 허용)
  tradingSignalId  String?
  positionThesisId String?

  // DAR-76: 철학 스타일별 모의운용 분기 — 스타일 태그(가산형, nullable).
  // 단일 시뮬(스타일 없음)은 null 유지 → 기존 데이터·집계 무손상. styleTags 패턴(investor_philosophies) 계승.
  styleTag String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [corpCode], references: [corpCode])
  tradingSignal  TradingSignal?  @relation(fields: [tradingSignalId], references: [id])
  positionThesis PositionThesis? @relation(fields: [positionThesisId], references: [id])

  @@index([corpCode])
  @@index([stockCode])
  @@index([status])
  @@index([entryDate])
  @@index([tradingSignalId])
  @@index([positionThesisId])
  @@index([styleTag])
  @@map("paper_trades")
}

// ====================================
// M11 — Engine5 Risk Engine (DAR-18)
// AI 금지영역: Risk 판정은 순수 Rule. AI 개입 0.
// ====================================

enum OrderRequestStatus {
  PENDING // 위험성 검사 전
  APPROVED // 위험성 검사 통과
  REJECTED // 위험성 검사 거부 (하드룰 위반)
  KILLED // Kill Switch에 의해 차단
  EXECUTED // 체결 완료
  CANCELLED // 취소
}

enum OrderSide {
  BUY
  SELL
}

enum AuditAction {
  ORDER_REQUESTED // 주문 요청
  RISK_PASSED // 위험성 검사 통과
  RISK_REJECTED // 위험성 검사 거부
  KILL_SWITCH_FIRED // Kill Switch 발동
  ORDER_EXECUTED // 체결 완료
  ORDER_CANCELLED // 취소
  KILL_SWITCH_SET // Kill Switch 수동 설정
  KILL_SWITCH_RESET // Kill Switch 수동 해제
}

model OrderRequest {
  id             String @id @default(cuid())
  idempotencyKey String @unique // 멱등 주문키 (중복 방지)

  corpCode        String
  stockCode       String
  side            OrderSide
  requestedShares Int
  limitPrice      Decimal?  @db.Decimal(12, 2) // null = 시장가

  // Risk 판정 결과
  status          OrderRequestStatus @default(PENDING)
  rejectionReason String? // 거부 사유 (하드룰 위반 내용)

  // 스냅샷 (판정 시점 포트폴리오 상태)
  capitalSnapshot    Decimal @db.Decimal(14, 2) // 판정 시점 총자산
  dailyLossSnapshot  Decimal @db.Decimal(12, 2) // 판정 시점 당일 손실
  weeklyLossSnapshot Decimal @db.Decimal(12, 2) // 판정 시점 주간 손실
  positionWeightSnap Decimal @db.Decimal(5, 4) // 판정 시점 종목 비중

  // Buy Score 스냅샷 (Risk veto 증적 — AI가 긍정이어도 Risk가 거부하면 거부 기록)
  buyScoreSnapshot Int?

  // 실행 연결
  paperTradeId String?
  executionId  String? // OrderExecution FK

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company           @relation(fields: [corpCode], references: [corpCode])
  execution OrderExecution?   @relation(fields: [executionId], references: [id])
  auditLogs TradingAuditLog[]

  @@index([corpCode])
  @@index([stockCode])
  @@index([status])
  @@index([createdAt])
  @@map("order_requests")
}

model OrderExecution {
  id String @id @default(cuid())

  corpCode       String
  stockCode      String
  side           OrderSide
  executedShares Int
  executedPrice  Decimal   @db.Decimal(12, 2)
  commission     Decimal   @default(0) @db.Decimal(12, 2)
  tax            Decimal   @default(0) @db.Decimal(12, 2)
  slippage       Decimal   @default(0) @db.Decimal(12, 2)
  netAmount      Decimal   @db.Decimal(14, 2) // 체결금액 - 비용

  executedAt DateTime
  createdAt  DateTime @default(now())

  company       Company           @relation(fields: [corpCode], references: [corpCode])
  orderRequests OrderRequest[]
  auditLogs     TradingAuditLog[]

  @@index([corpCode])
  @@index([executedAt])
  @@map("order_executions")
}

model TradingAuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  actorKind String // "SYSTEM" | "RISK_ENGINE" | "KILL_SWITCH" | "USER"
  summary   String // 한줄 요약

  // 연결 (nullable — Kill Switch 수동 조작 등 주문 없이도 기록)
  orderRequestId String?
  executionId    String?

  // 상세 메타 (JSON)
  meta Json?

  createdAt DateTime @default(now())

  orderRequest OrderRequest?   @relation(fields: [orderRequestId], references: [id])
  execution    OrderExecution? @relation(fields: [executionId], references: [id])

  @@index([action])
  @@index([orderRequestId])
  @@index([executionId])
  @@index([createdAt])
  @@map("trading_audit_logs")
}

model KillSwitchState {
  id            String    @id @default(cuid())
  isActive      Boolean   @default(false)
  reason        String? // 발동 사유
  triggeredBy   String    @default("SYSTEM") // "SYSTEM" | "USER"
  activatedAt   DateTime?
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("kill_switch_states")
}

// ====================================
// Persona 철학 엔진 P-A (DAR-48)
// 유명 투자자 철학을 구조화·정량화하여 저장. AI 미개입(순수 데이터/구조).
// 로드맵: docs/roadmap/cc-persona-philosophy-engine.md §2·§4 P-A
// ====================================

// 정량 지표 비교 연산자
enum PhilosophyMetricOperator {
  GT // ≥ (이상)
  LT // ≤ (이하)
  EQ // = (같음/충족)
  RANGE // 범위 [min, max]
}

// 철학 출처 유형
enum PhilosophySourceType {
  BOOK
  SHAREHOLDER_LETTER
  INTERVIEW
  PUBLIC_STATEMENT
}

// 유명 투자자 철학 (마스터)
// philosophyId 자연키(예: 'BUFFETT', 'LYNCH')로 식별 — P-B 스코어러가 참조.
model InvestorPhilosophy {
  philosophyId     String   @id // 고유 식별자 자연키 (예: 'BUFFETT', 'LYNCH', 'GREENBLATT', 'DRUCKENMILLER')
  investorName     String // 유명 투자자 이름
  styleTags        String[] // 스타일 태그 (예: ['VALUE','MOAT','LONG_TERM']) — 기존 4 persona(VALUE/GROWTH/MOMENTUM/EVENT_DRIVEN)와 연계 가능
  corePrinciples   String[] // 핵심 원칙 요약 (3~7개)
  applicableAssets String[] // 적용 자산군 (예: ['KR_STOCK','US_STOCK','CRYPTO'])
  checklistItems   String[] // 투자 전 체크리스트
  riskProfile      String // 리스크 성향 (예: '보수적', '공격적·집중투자')
  scoreFormula     String? // 스코어 산식 설명 (0~100 환산식, 참고용)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  metrics         PhilosophyMetric[]
  sources         PhilosophySource[]
  personaAnalyses PersonaAnalysis[]

  @@index([investorName])
  @@map("investor_philosophies")
}

// 철학별 정량 지표 매핑 (ROE·부채비율·PER·해자 등)
model PhilosophyMetric {
  id           String                   @id @default(cuid())
  philosophyId String // FK → InvestorPhilosophy
  metricKey    String // 지표 키 (예: 'ROE', 'DEBT_RATIO', 'PER', 'MOAT_SCORE')
  operator     PhilosophyMetricOperator // 비교 연산자
  threshold    Float // 기준값 (RANGE의 경우 하한)
  thresholdMax Float? // RANGE 상한 (operator=RANGE일 때만 사용)
  weight       Float // 가중치 0~1 (해당 철학 내 합산 = 1)
  description  String // 지표 설명

  philosophy InvestorPhilosophy @relation(fields: [philosophyId], references: [philosophyId], onDelete: Cascade)

  @@unique([philosophyId, metricKey]) // 철학 내 지표 키 유일 — 시드 멱등성 보장
  @@index([philosophyId])
  @@map("philosophy_metrics")
}

// 철학 출처 (공개 자료 기반)
model PhilosophySource {
  id           String               @id @default(cuid())
  philosophyId String // FK → InvestorPhilosophy
  type         PhilosophySourceType // 출처 유형
  title        String // 자료 제목
  year         Int // 발간/공개 연도
  url          String? // 공개 URL (주주서한 등)

  philosophy InvestorPhilosophy @relation(fields: [philosophyId], references: [philosophyId], onDelete: Cascade)

  @@unique([philosophyId, title]) // 철학 내 출처 제목 유일 — 시드 멱등성 보장
  @@index([philosophyId])
  @@map("philosophy_sources")
}

// ====================================
// 재무지표 (DAR-52 신규) — DART 정기공시 재무제표 수집
// ====================================

// 기업 재무지표 — DART 단일회사 전체 재무제표(fnlttSinglAcntAll) 기반.
// 자연키: corpCode + 기준연도(bsnsYear) + 보고서코드(reprtCode) + 재무제표구분(fsDiv).
// AI 미개입(순수 데이터/Rule 파생비율). Persona P-B 스코어러·BuyScore keyMetric이 읽는다.
model CompanyFinancial {
  id String @id @default(cuid())

  // ── 자연키 ──────────────────────────────────────────────────
  corpCode  String // DART 고유번호 (FK → Company.corpCode)
  stockCode String? // 종목코드 6자리 (조회 성능용 역정규화)
  bsnsYear  String // 사업연도 (예: '2025')
  reprtCode String // 보고서코드 11011(연간)/11012(반기)/11013(1Q)/11014(3Q)
  fsDiv     String  @default("CFS") // CFS(연결) | OFS(별도)

  // ── 핵심 지표 (원, BigInt — 조 단위 금액 안전 저장) ───────────
  revenue          BigInt? // 매출액
  operatingProfit  BigInt? // 영업이익
  netIncome        BigInt? // 당기순이익
  totalAssets      BigInt? // 자산총계
  totalLiabilities BigInt? // 부채총계
  totalEquity      BigInt? // 자본총계

  // ── 주당 지표 ────────────────────────────────────────────────
  eps Float? // 기본주당이익 (원)
  bps Float? // 주당순자산 (원) — 발행주식수 확보 시 보강

  // ── 파생 비율 (%) — 재무제표만으로 산출 ──────────────────────
  roe       Float? // 자기자본이익률 = 순이익/자본 × 100
  roa       Float? // 총자산이익률 = 순이익/자산 × 100
  debtRatio Float? // 부채비율 = 부채/자본 × 100

  // ── 시세 결합 파생 (가능 시 보강, 기본 null) ─────────────────
  per Float? // 주가수익비율 — 시세 결합 필요
  pbr Float? // 주가순자산비율 — 시세 결합 필요

  // ── 다년 시계열 성장률 (%) — DAR-93. 직전 기간 적재 후 산출·영속, 결측 시 null ──
  revenueGrowthYoY         Float? // 매출 YoY 성장률 (전년 동기 대비)
  operatingProfitGrowthYoY Float? // 영업이익 YoY 성장률
  epsGrowthYoY             Float? // EPS YoY 성장률
  revenueGrowthQoQ         Float? // 매출 QoQ 성장률 (직전 기간 대비, 누적기준)
  operatingProfitGrowthQoQ Float? // 영업이익 QoQ 성장률
  epsGrowthQoQ             Float? // EPS QoQ 성장률

  // ── 메타 ────────────────────────────────────────────────────
  rceptNo   String? // 원천 공시 접수번호 (추적용)
  currency  String   @default("KRW")
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [corpCode], references: [corpCode])

  @@unique([corpCode, bsnsYear, reprtCode, fsDiv]) // 멱등 upsert 자연키
  @@index([corpCode])
  @@index([bsnsYear])
  @@map("company_financials")
}

// 재무지표 수집 실행 로그 — 수집 서비스 멱등성·관측성 (MarketDataCollectionLog 패턴).
model FinancialCollectionLog {
  id           String    @id @default(cuid())
  bsnsYear     String // 수집 대상 사업연도
  reprtCode    String // 보고서코드
  fsDiv        String    @default("CFS")
  triggeredBy  String    @default("MANUAL") // "MANUAL" | "CRON"
  status       String    @default("RUNNING") // "RUNNING" | "SUCCESS" | "PARTIAL" | "FAILED"
  targetCount  Int       @default(0) // 수집 대상 기업 수
  savedCount   Int       @default(0) // upsert 성공 기업 수
  skippedCount Int       @default(0) // 데이터 없음/스킵 수
  failedCount  Int       @default(0) // 실패 수
  errorMessage String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  @@index([bsnsYear])
  @@index([status])
  @@map("financial_collection_logs")
}

// ====================================
// 크론 실행 헬스 로그 — 수집 안전망 (DAR-110, 패널 v5 #5)
// ====================================
// 도메인별 *CollectionLog(공시·재무·시세)와 별개로, 자체 로그가 없던 경량 크론
// (신호생성·모의운용·내부자수집·파싱재처리 등)의 마지막 성공시각/처리건수를 통일 기록한다.
// 각 @Cron 본문을 try/finally 로 감싸 성공/실패/건수를 남기는 단일 출처.
// freshness(데이터 신선도) 판정의 입력 — '조용히 멈춘' 수집을 인지하기 위한 메타 전용.
// AI·실주문·KRX 무관(수집 메타만). 기존 도메인 로그·크론 거동 불변(가산 테이블).
model CronRunLog {
  id           String    @id @default(cuid())
  jobKey       String // 크론 식별 키 (예: "signal.generate" | "paper.simulation" | "insider.daily" | "parse.retry")
  status       String    @default("RUNNING") // "RUNNING" | "SUCCESS" | "FAILED" | "SKIPPED"
  itemCount    Int       @default(0) // 처리/신규 건수 (도메인별 의미)
  durationMs   Int? // 실행 소요(ms). 미완료 시 null
  errorMessage String? // 실패 시 메시지 (SUCCESS/SKIPPED 시 null)
  triggeredBy  String    @default("CRON") // "CRON" | "MANUAL"
  startedAt    DateTime  @default(now())
  finishedAt   DateTime? // 종료 시각 (RUNNING 중에는 null)

  @@index([jobKey, startedAt]) // 잡별 최근 실행 조회용
  @@index([jobKey, status, finishedAt]) // 잡별 최근 성공 조회용
  @@index([status])
  @@map("cron_run_logs")
}

// DAR-411: 분봉 단타(intraday scalping) 모의전략 트랙.
//   당일 진입·당일 청산 forward-only 페이퍼 트랙(백테스트 불가 — 분봉은 당일 forward-only).
//   기존 PaperTrade(per-fill)와 달리 1행=1라운드트립(진입+청산) — 진입/청산 사유·분봉시각·일별 성과 기록.
//   자연키 corpCode/stockCode 는 인덱스만(StockMinutePrice 와 동일 패턴, FK 관계 없음=Company 무변경).
//   가산형 신규 테이블 — 기존 스키마 무변경.
model IntradayScalpTrade {
  id        String @id @default(cuid())
  corpCode  String // 기업 고유번호(자연키, 인덱스)
  stockCode String // 종목코드 6자리

  tradeDate String // YYYYMMDD (KST 거래일) — 당일 진입·당일 청산

  // 진입 (분봉 신호)
  entryTs          DateTime // 진입 분봉 시각(체결 기준)
  entryPrice       Decimal  @db.Decimal(12, 2) // 진입 체결가(슬리피지 반영)
  shares           Int // 체결 수량
  entryReason      String // 진입 사유 태그(예: VOLUME_BREAKOUT_VWAP)
  entryVwap        Decimal? @db.Decimal(12, 2) // 진입 시 당일 VWAP
  entryVolumeRatio Decimal? @db.Decimal(8, 2) // 진입 시 거래량/직전평균 배수

  // 청산
  exitTs      DateTime? // 청산 분봉 시각
  exitPrice   Decimal?  @db.Decimal(12, 2) // 청산 체결가
  exitReason  String? // TAKE_PROFIT | STOP_LOSS | FORCE_CLOSE_EOD
  holdMinutes Int? // 보유 분

  // 비용·손익 (KRW)
  commission Decimal  @default(0) @db.Decimal(12, 2) // 수수료(진입+청산)
  tax        Decimal  @default(0) @db.Decimal(12, 2) // 매도 증권거래세
  slippage   Decimal  @default(0) @db.Decimal(12, 2) // 슬리피지 비용(진입+청산)
  grossPnl   Decimal? @db.Decimal(14, 2) // 총손익(비용 전)
  netPnl     Decimal? @db.Decimal(14, 2) // 순손익(비용 후)
  returnPct  Decimal? @db.Decimal(8, 4) // 순수익률(%)

  status   String @default("OPEN") // OPEN | CLOSED
  styleTag String @default("intraday-scalp") // 트랙 식별 태그(SSOT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([tradeDate])
  @@index([stockCode])
  @@index([corpCode])
  @@index([styleTag])
  @@map("intraday_scalp_trades")
}

/// DAR-494 [견고화 W1·P13]: 듀얼모멘텀 코어 forward 트랙 — ETF 단일 보유 월말 리밸런싱 이력.
///
/// ETF 는 DART corpCode 가 없어 Position/PaperTrade(→Company FK 필수)에 부적합하다
///   (EtfDailyPrice 가 전용 모델로 분리된 것과 동일 이유·DAR-484). 분봉 단타(IntradayScalpTrade)
///   전례처럼 FK 없는 전용 모델로 분리한다. 자연키 = etfCode(6자리 단축코드), styleTag SSOT.
///
/// 라이프사이클(단일 자산 100% 배분): PENDING(익일 시가 매수 예약) → OPEN(체결·보유) →
///   CLOSED(다음 리밸런싱 SWITCH 매도). 결측/이월 상한 초과 예약은 CANCELLED.
/// ★가산(additive)·데이터층 전용 — 기존 측정 트랙 매매 행동 무접촉(M10 클록 안전).
model DualMomentumForwardTrade {
  id       String @id @default(cuid())
  etfCode  String // 대상/보유 ETF 6자리 단축코드(360750/069500/153130/273130)
  styleTag String @default("alloc:dual-momentum") // 트랙 식별 태그(룰북 §9.2 SSOT)

  status String @default("PENDING") // PENDING | OPEN | CLOSED | CANCELLED

  // 판정·예약 (월말 결정 시 기록)
  decisionDate   String // 리밸런싱 판정 거래일 YYYYMMDD (매월 마지막 거래일)
  entryTradeDate String // 체결 예정 거래일 YYYYMMDD (익일 시가) = nextTradingDay(decisionDate)
  reservedShares Int     @default(0) // 예약 시 명목 수량(사이징 근거·상한). 체결 시 실수량으로 갱신.
  reservedPrice  Decimal @db.Decimal(12, 2) // 예약 기준가(판정일 종가 — 사이징 근거)

  // 진입 (익일 시가 체결 시 기록)
  entryTs    DateTime? // 실제 매수 체결 시각
  entryPrice Decimal?  @db.Decimal(12, 2) // 매수 체결가(슬리피지 반영)
  shares     Int       @default(0) // 체결 수량

  // 청산 (다음 리밸런싱 SWITCH 시 매도)
  exitTs    DateTime? // 매도 체결 시각
  exitDate  String? // 매도 체결 거래일 YYYYMMDD
  exitPrice Decimal?  @db.Decimal(12, 2) // 매도 체결가(슬리피지 반영)

  // 비용·손익 (KRW 절대값)
  commission Decimal  @default(0) @db.Decimal(14, 2) // 수수료(진입+청산 누적)
  tax        Decimal  @default(0) @db.Decimal(14, 2) // 매도 증권거래세(ETF 면제 → 0)
  slippage   Decimal  @default(0) @db.Decimal(14, 2) // 슬리피지 비용(진입+청산 누적)
  grossPnl   Decimal? @db.Decimal(16, 2) // 총손익(비용 전)
  netPnl     Decimal? @db.Decimal(16, 2) // 순손익(비용 후)
  returnPct  Decimal? @db.Decimal(8, 4) // 순수익률(%)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([styleTag])
  @@index([entryTradeDate])
  @@index([decisionDate])
  @@map("dual_momentum_forward_trades")
}

// DAR-496 [견고화 W2·P18]: RiskGuard 공용 진입 게이트 판정 이력.
//   일일손실·현금 가드 게이트(risk-guard-gate.ts)가 전 트랙 진입 확정 직전에 남기는 판정 로그.
//   - 측정 트랙(시스템 모의·철학·전략 forward·분봉)은 SHADOW → 위반을 기록만(차단 0).
//   - 듀얼모멘텀 코어 forward 는 ENFORCE → 위반 시 BLOCK 기록.
//   기존 TradingAuditLog 는 OrderRequest/OrderExecution(M11 실주문 루프) 전용 스키마이고
//   AuditAction enum 이 닫힌 집합이라, 페이퍼 진입 게이트(주문 FK 없음·고빈도 SHADOW 텔레메트리)
//   에는 부적합하다 → DAR-494 전례처럼 FK 없는 전용 additive 모델로 분리한다(택1 근거).
//   비파괴 순수 가산 — 기존 스키마 무변경(M10 클록 안전).
model RiskDecisionLog {
  id     String @id @default(cuid())
  track  String // paper-simulation | philosophy-style | strategy-forward | intraday-scalp | dual-momentum-forward
  mode   String // SHADOW | ENFORCE
  action String // ALLOW | SHADOW_VIOLATION | BLOCK

  tradeDate String // 판정 거래일 YYYYMMDD (일 1회 dedupe 버킷)

  // 판정 컨텍스트(진입 확정 직전 스냅샷)
  totalCapital     Decimal @db.Decimal(16, 2) // 트랙 가상원금
  dailyRealizedPnl Decimal @db.Decimal(16, 2) // 당일 실현손익(음수=손실)
  availableCash    Decimal @db.Decimal(16, 2) // 진입 직전 가용현금
  entryBudget      Decimal @db.Decimal(16, 2) // 이번 진입 예산

  // 위반 코드(콤마 구분, 없으면 빈 문자열) + 상세 메타
  violationCodes String  @default("") // 예: "DAILY_LOSS,CASH_GUARD"
  corpCode       String? // 진입 대상(있으면)
  stockCode      String?
  meta           Json? // 위반 상세·killSwitch 등 관측용 부가 컨텍스트

  createdAt DateTime @default(now())

  @@index([track])
  @@index([tradeDate])
  @@index([action])
  @@index([createdAt])
  @@map("risk_decision_logs")
}

// 계좌 고점(High-Water Mark) 추적 — 드로다운 컷(룰북 §7.5) 발동 근거 (DAR-497 [견고화 W2·P19]).
//
// 배경(갭 A2): 계좌 고점 추적·드로다운 임계 트리거가 전무해 룰북 8-6(-15~20% 컷·자동 재개 금지)이
//    발화 자체가 불가능했다. 기간 리셋(일간/주간 캡)은 자동 재개라 요건과 상충 → 리셋 없는 영속 고점 필요.
//
// ★설계: 트랙 하위 **포트폴리오 단위**(철학·전략 forward 는 4종 각각 별 포트폴리오) 고점을 영속한다.
//    - 초기값 = 최초 관측 시점의 총자산(과거 소급 산정 금지 — 룩어헤드·리셋 정합). 이후 forward-only 로
//      max 갱신만 한다(하락해도 고점은 내려가지 않음 = 진짜 HWM).
//    - 드로다운 = (현재총자산 − 고점) / 고점. −15%(G6 임계·frozen) 도달 시 DRAWDOWN_CUT.
//    - 자연키 = portfolioId(유니크). 관계 FK 없음(RiskDecisionLog·DualMomentumForwardTrade 전례 —
//      Portfolio 는 삭제/재생성될 수 있고 측정 트랙 오염 방지 위해 additive 분리).
model AccountHighWaterMark {
  id          String @id @default(cuid())
  portfolioId String @unique // 트랙 하위 포트폴리오 단위 고점(철학/전략 forward 는 4종 각각)
  track       String // RiskGuardTrack — 모드 해석·감사(paper-simulation|philosophy-style|strategy-forward|dual-momentum-forward)

  highWaterMark Decimal @db.Decimal(16, 2) // 계좌 고점(총자산, forward-only max)
  peakDate      String // 고점 도달 거래일 YYYYMMDD
  lastEquity    Decimal @db.Decimal(16, 2) // 최근 관측 총자산
  lastDate      String // 최근 관측 거래일 YYYYMMDD

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([track])
  @@map("account_high_water_marks")
}

// ====================================
// AOS 전략·룰 버전 관리
// ====================================

// 전략 정의 자체의 관리 상태. 실제 실행 가능 여부는 StrategyVersion.status가 결정한다.
enum StrategyDefinitionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

// 룰이 담당하는 결정 단계. AI 산출물은 입력 특성일 뿐 이 분류의 실행 주체가 아니다.
enum StrategyRuleCategory {
  ENTRY
  EXIT
  SIZING
  REGIME
  PORTFOLIO
  RISK
}

// 버전은 검증·백테스트·승인·예약을 거쳐야 ACTIVE가 될 수 있다.
// DRAFT 이후의 설정 본문은 DB trigger와 도메인 상태 머신 양쪽에서 불변으로 보호한다.
enum StrategyVersionStatus {
  DRAFT
  VALIDATED
  BACKTESTED
  APPROVAL_PENDING
  APPROVED
  SCHEDULED
  ACTIVE
  REJECTED
  SUPERSEDED
  ROLLED_BACK
  RETIRED
}

model Strategy {
  id             String                   @id @default(cuid())
  key            String                   @unique
  name           String
  description    String?
  assetClass     String                   @default("KR_STOCK")
  direction      String                   @default("LONG_ONLY")
  horizonMinDays Int                      @default(2)
  horizonMaxDays Int                      @default(20)
  status         StrategyDefinitionStatus @default(DRAFT)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User?             @relation("StrategyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  versions  StrategyVersion[]

  @@index([status])
  @@index([assetClass])
  @@map("aos_strategies")
}

model RuleDefinition {
  id                  String               @id @default(cuid())
  key                 String               @unique
  category            StrategyRuleCategory
  name                String
  description         String?
  implementationKey   String
  inputSchemaVersion  Int
  outputSchemaVersion Int
  isActive            Boolean              @default(true)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy    User?                 @relation("RuleDefinitionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  versionRules StrategyVersionRule[]

  @@index([category])
  @@index([isActive])
  @@map("aos_rule_definitions")
}

model StrategyVersion {
  id         String                @id @default(cuid())
  strategyId String
  version    Int
  status     StrategyVersionStatus @default(DRAFT)
  configJson Json
  configHash String

  parentVersionId String?
  createdByUserId String?
  validatedAt     DateTime?
  approvedAt      DateTime?
  effectiveFrom   DateTime?
  retiredAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  strategy  Strategy              @relation(fields: [strategyId], references: [id], onDelete: Restrict)
  parent    StrategyVersion?      @relation("StrategyVersionParent", fields: [parentVersionId], references: [id], onDelete: SetNull)
  children  StrategyVersion[]     @relation("StrategyVersionParent")
  createdBy User?                 @relation("StrategyVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  rules     StrategyVersionRule[]

  @@unique([strategyId, version])
  @@index([strategyId, configHash])
  @@index([status, effectiveFrom])
  @@index([parentVersionId])
  @@map("aos_strategy_versions")
}

model StrategyVersionRule {
  id                String   @id @default(cuid())
  strategyVersionId String
  ruleDefinitionId  String
  priority          Int
  enabled           Boolean  @default(true)
  weight            Decimal? @db.Decimal(8, 6)
  parametersJson    Json
  parameterHash     String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  strategyVersion StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)
  ruleDefinition  RuleDefinition  @relation(fields: [ruleDefinitionId], references: [id], onDelete: Restrict)

  @@unique([strategyVersionId, ruleDefinitionId], map: "aos_version_rules_version_rule_key")
  @@index([strategyVersionId, priority])
  @@index([ruleDefinitionId])
  @@map("aos_strategy_version_rules")
}
