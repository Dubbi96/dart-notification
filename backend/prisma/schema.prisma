// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================
// 사용자 관련
// ====================================

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String? // bcrypt 해싱
  name       String?
  provider   String   @default("local") // "local" | "kakao" | "google"
  providerId String? // kakao user id
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  devices              UserDevice[]
  watchLists           WatchList[]
  savedDisclosures     SavedDisclosure[]
  notificationSettings NotificationSettings?
  notificationHistory  NotificationHistory[]
  portfolios           Portfolio[]
  refreshTokens        RefreshToken[]

  @@unique([provider, providerId])
  @@index([email])
  @@map("users")
}

// 발급된 refresh 토큰의 해시를 보관해 취소·회전(rotation)을 가능하게 한다.
// 무상태 JWT만으로는 로그아웃/탈취 시 90일간 폐기가 불가능하므로, 발급마다 한 행을
// 만들고 refresh 시 일치 검증 후 회전(이전 행 revoke)한다.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // refresh JWT 의 SHA-256 해시 (원문 비저장)
  expiresAt DateTime // refresh JWT 만료 시각 (발급 + 90d)
  revokedAt DateTime? // 회전·로그아웃으로 폐기된 시각 (null = 유효)
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model UserDevice {
  id          String   @id @default(cuid())
  userId      String
  deviceToken String   @unique // Expo Push Token
  platform    String // "ios" | "android"
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceToken])
  @@map("user_devices")
}

// ====================================
// 기업 마스터
// ====================================

model Company {
  corpCode  String  @id // DART 고유번호 (8자리)
  corpName  String // 기업명
  stockCode String? // 종목코드 (6자리, 비상장은 null)
  market    String? // "KOSPI" | "KOSDAQ" | null

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  watchLists          WatchList[]
  disclosures         Disclosure[]
  disclosureDocuments DisclosureDocument[]
  dartFiledFacts      DartFiledFact[]
  disclosureEvents    DisclosureEvent[]
  insiderHoldingChanges InsiderHoldingChange[]
  stockDailyPrices    StockDailyPrice[]
  technicalIndicators TechnicalIndicator[]
  tradingSignals      TradingSignal[]
  positionTheses      PositionThesis[]
  positions           Position[]
  paperTrades         PaperTrade[]
  orderRequests       OrderRequest[]
  orderExecutions     OrderExecution[]
  companyFinancials   CompanyFinancial[]

  @@index([corpName]) // 자동완성 검색용
  @@index([stockCode])
  @@map("companies")
}

model CompanyOverview {
  corpCode     String   @id
  corpName     String
  corpNameEng  String?
  stockName    String?
  ceoName      String?
  corpCls      String?
  address      String?
  homepageUrl  String?
  industryCode String?
  estDate      String?
  accMonth     String?
  fetchedAt    DateTime @default(now())

  @@map("company_overviews")
}

// ====================================
// 관심 목록
// ====================================

model WatchList {
  id           String    @id @default(cuid())
  userId       String
  corpCode     String // DART 고유번호
  corpName     String // 기업명 (중복 저장, 조회 성능)
  createdAt    DateTime  @default(now())
  lastViewedAt DateTime? // 사용자가 해당 종목을 마지막으로 조회한 시각 (표시용, DAR-165)
  // DAR-185: 마지막으로 본 공시의 rcpNo 커서. rcpNo(=YYYYMMDD+일련번호, 사전식 단조)는
  // 일(day) 단위라 시각을 잃는 rcpDt 와 달리 같은 날 안의 순서까지 보존하므로,
  // 이 커서보다 큰 rcpNo 만 신규로 집계하면 당일 공시도 정확히 잡히고 조회 즉시 배지가 0이 된다.
  // 실 rcpNo 값만 저장(커서 스냅샷)하며 Disclosure 행 삭제와 무관해야 하므로 FK 로 묶지 않는다.
  lastViewedRcpNo String?

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [corpCode], references: [corpCode])

  @@unique([userId, corpCode]) // 같은 기업 중복 등록 방지
  @@index([userId])
  @@index([corpCode])
  @@map("watch_lists")
}

// ====================================
// 알림 설정
// ====================================

model NotificationSettings {
  userId          String   @id
  disclosureTypes String[] // ["정기공시", "주요사항보고", "발행공시", "지분공시", "기타공시"]
  keywords        String[] // 키워드 배열 (예: ["증자", "배당"])
  isEnabled       Boolean  @default(true) // master 푸시 스위치(공시 포함)

  // DAR-85: 신호·청산·논리훼손 푸시 토글. ★기본 OFF(스팸 차단·안전).
  // OFF면 NotificationHistory(인박스) 기록만 하고 실발송하지 않는다.
  signalPushEnabled Boolean @default(false) // 매수 신호(SIGNAL) 푸시
  exitPushEnabled   Boolean @default(false) // 청산 권고(EXIT) 푸시
  thesisPushEnabled Boolean @default(false) // 투자논리 훼손(THESIS_VIOLATED) 푸시

  updatedAt       DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// ====================================
// 공시 데이터
// ====================================

model Disclosure {
  rcpNo          String @id // DART 접수번호 (고유키)
  corpCode       String // 기업 고유번호
  corpName       String // 기업명
  reportName     String // 보고서명
  rcpDt          String // 접수일시 (YYYYMMDD 또는 YYYYMMDDHHmmss)
  flrName        String // 공시제출인명
  rmk            String // 비고
  disclosureType String // 공시 유형 (정기공시, 주요사항보고 등)

  // DAR-129: 과거 공시 대량 백필 표식.
  // true = 추이/분석 baseline 용도로만 적재된 과거 공시.
  //   라이브 신호 생성·신호 피드·푸시 알림에서 절대 제외(불가침).
  //   Event Study·통계·백테스트 등 분석은 백필 포함 전체 사용.
  isBackfill Boolean @default(false)

  createdAt DateTime @default(now())

  // Relations
  company             Company               @relation(fields: [corpCode], references: [corpCode])
  savedDisclosures    SavedDisclosure[]
  notificationHistory NotificationHistory[]
  document            DisclosureDocument?
  dartFiledFacts      DartFiledFact[]
  disclosureEvent     DisclosureEvent?
  disclosureAnalyses  DisclosureAnalysis[]
  personaAnalysis     PersonaAnalysis?
  tradingSignals      TradingSignal[]
  positionTheses      PositionThesis[]
  exitSignals         ExitSignal[]

  @@index([corpCode])
  @@index([rcpDt])
  @@index([disclosureType])
  @@index([createdAt]) // 최근 공시 조회용
  @@index([isBackfill]) // DAR-129: 신호생성·신호피드 백필 제외 필터 조회용
  @@index([corpCode, rcpNo]) // DAR-214: 워치리스트 신규 공시 grouped count(corpCode + rcpNo>커서) 조인용
  @@index([corpCode, rcpDt, rcpNo]) // DAR-276: 기업상세 공시목록 where{corpCode}+orderBy[rcpDt desc,rcpNo desc] 필터+정렬 커버(메모리정렬 해소)
  @@map("disclosures")
}

// ====================================
// 저장된 공시
// ====================================

model SavedDisclosure {
  id              String   @id @default(cuid())
  userId          String
  disclosureRcpNo String // DART 접수번호 (FK → Disclosure.rcpNo)
  createdAt       DateTime @default(now())

  // Relations
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  disclosure Disclosure @relation(fields: [disclosureRcpNo], references: [rcpNo], onDelete: Cascade)

  @@unique([userId, disclosureRcpNo]) // 중복 저장 방지
  @@index([userId, createdAt])
  @@map("saved_disclosures")
}

// ====================================
// 알림 히스토리
// ====================================

// 통합 알림 유형 (DAR-84) — 공시 외 신호·청산·논리훼손 통지를 한 인박스에 수용
enum NotificationType {
  DISCLOSURE // 공시 (기존)
  SIGNAL // 매매 신호 (engine3/6)
  EXIT // 청산 신호 (engine4)
  THESIS_VIOLATED // 투자논리 훼손 (engine4)
}

model NotificationHistory {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType @default(DISCLOSURE) // DAR-84 통합 인박스 타입
  refId  String? // 다형 참조키 (rcpNo/signalId/positionId) — 앱레벨 무결성, DB FK 미강결합
  title  String? // 통지 제목 (공시 외 타입용; 공시는 disclosure 조인 폴백 가능)
  body   String? // 통지 본문
  deepLink String? // 인앱 딥링크 (예: /disclosure/:rcpNo, /signal/:id)

  // 기존 공시 전용 필드 — disclosureRcpNo는 nullable로 완화(공시 외 타입 수용)
  disclosureRcpNo String? // DART 접수번호 (FK → Disclosure.rcpNo, nullable)
  sentAt          DateTime  @default(now())
  isRead          Boolean   @default(false)
  readAt          DateTime?

  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  disclosure Disclosure? @relation(fields: [disclosureRcpNo], references: [rcpNo], onDelete: Cascade)

  @@unique([userId, type, refId]) // DAR-84: type+refId 단위 멱등(공시 중복방지 재설계). 공시는 refId=rcpNo
  @@index([userId, isRead]) // 읽지 않은 알림 조회용
  @@index([userId, sentAt]) // 알림 목록 조회용
  @@map("notification_history")
}

// ====================================
// 공시 원문 파싱 상태 enum (M1 신규)
// ====================================

enum ParseStatus {
  PENDING // 파싱 미처리 (수집 완료 직후 자동 생성)
  FETCHING // DART 원문 다운로드 진행 중
  FETCH_FAILED // 다운로드 실패 (retryCount 증가, 재처리 큐 대상)
  PARSING // 텍스트·표 파싱 진행 중
  PARSE_FAILED // 파싱 실패 (retryCount 증가, 재처리 큐 대상)
  DONE // 파싱 완료 (rawText + parsedJson 저장됨)
  SKIPPED // MAX_RETRY 초과 또는 단순 공시(파싱 불필요) 판정
}

// ====================================
// 공시 원문 파싱 결과 (M1 신규)
// ====================================

model DisclosureDocument {
  // 자연키 PK — Disclosure.rcpNo와 1:1 매핑
  rcpNo String @id

  // 역정규화: 조회 성능을 위해 corpCode 중복 저장
  corpCode String

  // 원문 파일 저장 위치
  // 개발: backend/storage/{rcpNo}/index.html (gitignored)
  // 프로덕션: S3 key = dart-documents/{rcpNo}/index.html (후속 M)
  rawFilePath String?

  // 첨부 ZIP 내 추출 파일 경로 목록 (없으면 빈 배열)
  attachmentPaths String[]

  // 파싱 결과
  rawText    String? @db.Text // 태그 제거 후 순수 텍스트 (200KB 상한 truncate)
  tables     Json? // 추출된 표 목록: Table[] (하단 JSON 스키마 참고)
  parsedJson Json? // 핵심 key-value 구조화 결과 (하단 parsedJson 스키마 참고)
  wordCount  Int? // rawText 글자 수 (AI 입력 비용 예측, M3/M4 비용 게이트용)

  // 정정공시 관계
  isAmendment   Boolean @default(false) // Disclosure.rmk 기반 정정 여부
  originalRcpNo String? // 원공시 rcpNo — 자기참조 (정정 시에만)
  amendmentDiff Json? // 정정 전후 변경 필드 diff (FieldDiff[] 구조)

  // 상태 관리
  parseStatus ParseStatus @default(PENDING)
  fetchedAt   DateTime? // DART 원문 다운로드 완료 시각
  parsedAt    DateTime? // rawText/tables/parsedJson 저장 완료 시각
  retryCount  Int         @default(0) // 실패 재처리 누적 횟수 (MAX = 3)
  lastError   String? // 마지막 실패 오류 메시지 (500자 상한 truncate)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  disclosure Disclosure @relation(fields: [rcpNo], references: [rcpNo], onDelete: Cascade)
  company    Company    @relation(fields: [corpCode], references: [corpCode])

  // 인덱스 — 배치 처리·상태 조회·정정공시 연결 성능
  @@index([corpCode])
  @@index([parseStatus])
  @@index([isAmendment])
  @@index([originalRcpNo])
  @@index([fetchedAt])
  @@map("disclosure_documents")
}

// ====================================
// 공시 본문 정량표 구조화 추출 (DAR-95 신규)
// ====================================
//
// ★Main Thesis A: 가장 풍부한 1차 정보원(document.xml 본문)의 자산화.
// 기존 파이프라인은 표 파싱 결과(parsedJson)를 이벤트당 1회성으로만 휘발 소비했다.
// DartFiledFact는 그 정량값을 표준 factKey로 정규화해 영구 적재하는 분석 자산이다.
// AI 미개입(순수 Rule 정규화). 신규 외부 호출 0(이미 받은 XML 재활용).
// 자연키 rcpNo 정합 — DisclosureDocument.rawText/tables 원본 보존 → 언제든 재처리 가능.
model DartFiledFact {
  id String @id @default(cuid())

  // 자연키 — Disclosure.rcpNo (DisclosureDocument와 동일 rcpNo)
  rcpNo String
  // 역정규화: 종목 단위 조회 성능
  corpCode String

  // 표준 키 (예: CONTRACT_AMOUNT, CB_CONVERSION_PRICE, DIVIDEND_PAYOUT_RATIO)
  factKey String
  // 원시값의 정규화 문자열 표현 (숫자·날짜·텍스트 공통 보존)
  value String
  // 숫자형 값 (금액·수량·비율 등) — 텍스트형 fact는 null
  numericValue Float?
  // 단위 (원, 주, %, ratio 등) — 결측 시 null
  unit String?
  // 기간/일자 정보 (YYYY-MM-DD 또는 원문 기간 표현) — 결측 시 null
  period String?
  // 추출 출처 경로 (예: parsedJson.contractAmount, table_0/contractAmount)
  sectionPath String?

  // 정규화 소스 docType(이벤트 유형) — 추적·재처리용
  docType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations — rcpNo 정합 + corpCode 종목 결합 (DisclosureDocument 패턴 미러)
  disclosure Disclosure @relation(fields: [rcpNo], references: [rcpNo], onDelete: Cascade)
  company    Company    @relation(fields: [corpCode], references: [corpCode])

  // 멱등키: 한 공시(rcpNo) 안에서 factKey는 유일 — 재적재 시 upsert/replace로 중복 방지
  @@unique([rcpNo, factKey])
  @@index([corpCode])
  @@index([factKey])
  @@map("dart_filed_facts")
}

// ====================================
// 이벤트 타입 enum (M2 신규)
// ====================================

enum EventType {
  // ── 우선 추출 7종 ──────────────────────────────
  SUPPLY_CONTRACT // 단일판매·공급계약 체결
  SHARE_BUYBACK // 자기주식 취득
  SHARE_CANCELLATION // 자기주식 소각
  DIVIDEND_INCREASE // 배당 확대 (현금·현물)
  PAID_IN_CAPITAL_INCREASE // 유상증자 (주주배정·일반공모)
  CB_ISSUANCE // 전환사채 발행
  BW_ISSUANCE // 신주인수권부사채 발행

  // ── enum 포함 (추출 구현은 후속 이터레이션) ──────
  CONTRACT_CANCELLATION // 단일판매·공급계약 해제·취소
  DIVIDEND_CUT // 배당 축소·중단
  THIRD_PARTY_ALLOTMENT // 제3자배정 유상증자
  EARNINGS_SURPRISE // 실적 서프라이즈
  EARNINGS_SHOCK // 실적 쇼크
  MAJOR_SHAREHOLDER_CHANGE // 최대주주 변경
  LAWSUIT // 소송·횡령·배임
  AUDIT_OPINION_RISK // 감사의견 거절·한정
  TRADING_SUSPENSION // 거래정지
  DELISTING_RISK // 상장폐지 위험·관리종목

  // ── 지분변동 3종 (DAR-87, 내부자·대량보유 수집) ──────────────
  INSIDER_BUY // 임원·주요주주 순매수 (특정증권등 소유 증가)
  INSIDER_SELL // 임원·주요주주 순매도 (특정증권등 소유 감소)
  MAJOR_HOLDER_5PCT // 5%(대량보유) 상황보고 — 지분율 변동

  // ── DAR-346: 미모델 공시유형 분류 확대 (OTHER 4225 축소) ──────────────
  // 라이브 DisclosureEvent OTHER 상위 reportName 패턴(전수조사) 기반 신규 분류 타입.
  // 대부분 정형 수치 추출기는 후속 이터레이션 — 우선 "분류조차 안 됨(OTHER)" 상태 해소가 목표.
  INSIDER_TRADING_REPORT // 임원·주요주주 특정증권등 소유·거래 보고 (방향 미상)
  SECURITIES_OFFERING // 증권신고서·투자설명서·증권발행실적·일괄신고추가서류·증권발행결과
  PERIODIC_DISCLOSURE // 사업·반기·분기보고서·(연결)감사보고서 등 정기/감사 보고
  SHAREHOLDER_MEETING // 주주총회 소집·결과·의결권대리행사·주주명부폐쇄/기준일
  IR_EVENT // 기업설명회(IR) 개최·결과
  RELATED_PARTY_TRANSACTION // 특수관계인 거래(자금·담보·상품용역)·동일인등 출자계열 거래
  AFFILIATE_GROUP_DISCLOSURE // 대규모기업집단 현황공시
  OWNERSHIP_DISCLOSURE // 최대주주등 소유주식 변동신고·주식보유변동 (지배변경 아님)
  DEBT_GUARANTEE // 채무보증·담보제공·자금대여·금전대여 결정
  CAPITAL_REDUCTION // 감자(자본감소) 결정·완료·주식병합
  BONUS_ISSUE // 무상증자 결정
  MERGER_SPLIT // 합병·분할·회사합병·자산양수도 (M&A)
  INVESTMENT_DECISION // 타법인주식취득·신규시설투자·유형/비유동자산 양수·투자판단 주요경영사항
  STOCK_OPTION // 주식매수선택권(스톡옵션) 부여
  EXECUTIVE_CHANGE // 대표이사·임원·사외이사 선임/해임/변경
  INQUIRY_DISCLOSURE // 조회공시 요구·답변·풍문/보도 해명
  MARKET_NOTICE // 거래소 기타 시장안내
  CONVERTIBLE_EXERCISE // 전환청구권 행사·전환/행사가액 조정

  OTHER // 분류 불가 (NEEDS_REVIEW 대상)
}

// ====================================
// 추출 상태 enum (M2 신규)
// ====================================

enum ExtractionStatus {
  PENDING // 추출 미처리
  SUCCESS // 추출 완료
  FAILED // 추출 실패 (parsedJson 없음 또는 파서 오류)
  NEEDS_REVIEW // confidence 낮거나 필수 필드 누락 — 관리자 검토 대기
}

// ====================================
// 공시 이벤트 추출 결과 (M2 신규)
// ====================================

model DisclosureEvent {
  id String @id @default(cuid())

  // ── FK: Disclosure (rcpNo 자연키, 1:1) ──────────────────────
  // 공시 1건 = 이벤트 1건 원칙.
  // 복수 이벤트 공시(CB + 유상증자 동시)는 extractedData.events[] 배열로 처리하고
  // eventType은 우선순위 높은 것으로 단일 지정한다.
  rcpNo    String @unique
  corpCode String // 역정규화 — 조회 성능용. Disclosure.corpCode와 항상 동일

  // ── 이벤트 분류 ──────────────────────────────────────────────
  eventType EventType

  // ── 이벤트별 핵심 수치 JSON ────────────────────────────────────
  // 이벤트 타입별 스키마는 계약서 §2 참고. 추출 실패 시 빈 JSON `{}` 저장.
  extractedData Json @default("{}")

  // ── 극성 ──────────────────────────────────────────────────────
  // Rule 매핑 테이블의 polarity 값으로 초기 설정. AI 보정은 M3.
  polarity String @default("UNKNOWN") // "POSITIVE" | "NEGATIVE" | "MIXED" | "UNKNOWN"

  // ── 신뢰도 및 검증 ────────────────────────────────────────────
  confidence       Float            @default(0.0) // 0.0~1.0. Rule ≥ 0.85, AI보조 0.6~0.85
  isAiAssisted     Boolean          @default(false) // confidence < 0.85 시 AI L1 개입 여부
  extractionStatus ExtractionStatus @default(PENDING)
  failReason       String? // 실패 사유 (500자 상한)

  // ── 정정공시 연결 ────────────────────────────────────────────
  isAmendment   Boolean @default(false)
  originalRcpNo String? // 정정 대상 원공시 rcpNo

  extractedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  disclosure Disclosure @relation(fields: [rcpNo], references: [rcpNo])
  company    Company    @relation(fields: [corpCode], references: [corpCode])

  @@index([corpCode])
  @@index([eventType])
  @@index([polarity])
  @@index([extractionStatus])
  @@index([extractedAt])
  @@index([isAmendment])
  @@index([corpCode, extractedAt]) // DAR-276: 기업별 이벤트목록 where{corpCode}+orderBy{extractedAt desc} 필터+정렬 커버(메모리정렬 해소)
  @@map("disclosure_events")
}

// ====================================
// 내부자·대량보유 지분변동 (DAR-87, engine1 수집)
// ====================================
// DART 정형 엔드포인트 2종을 수집·정규화한 행:
//   - majorstock.json  : 주식등의 대량보유상황보고(5%룰)         → source = MAJOR_STOCK
//   - elestock.json    : 임원·주요주주 특정증권등 소유상황보고   → source = EXECUTIVE
// 미공개 펀더멘털 주체(내부자·5%보유자)의 매매는 강한 행동신호.
// 자연키: corpCode(FK → Company). 멱등키: (source, rcptNo, reporter).
// AI 미개입(순수 Rule). tradeType/source/polarity는 문자열(가산 안전).
model InsiderHoldingChange {
  id String @id @default(cuid())

  // ── 출처 & 자연키 ────────────────────────────────────────────
  source   String // "MAJOR_STOCK" | "EXECUTIVE"
  rcptNo   String // DART 접수번호 (보고서 단위)
  corpCode String // FK → Company

  // ── 보고자 ───────────────────────────────────────────────────
  reporter String // 보고자명 (repror)
  relation String? // 관계/직위 (등기임원·주요주주·5%보유자 등)

  // 임원·주요주주 보고서 부가 플래그 (elestock 전용, majorstock은 null)
  isExecutive       Boolean? // 임원 여부
  isRegistered      Boolean? // 등기임원 여부
  isMajorShareholder Boolean? // 주요주주 여부

  // ── 보유수량/비율 (전·후·증감) ──────────────────────────────
  sharesAfter  BigInt? // 보유(소유) 주식등의 수 — 보고 후
  sharesChange BigInt? // 증감 수 (+취득 / -처분)
  ratioAfter   Float? // 보유(소유) 비율 % — 보고 후
  ratioChange  Float? // 비율 증감 %p

  // ── 매매 방향 & 단가 ─────────────────────────────────────────
  tradeType String // "BUY" | "SELL" | "MIXED" | "UNKNOWN"
  unitPrice Float? // 취득·처분 단가 (KRW, 결측 가능)

  // ── 사유 & 보고일 ────────────────────────────────────────────
  reportReason String? // 보고사유 (대량보유 report_resn 등)
  reportedAt   DateTime? // 접수일(rcept_dt) 파싱

  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company Company @relation(fields: [corpCode], references: [corpCode])

  @@unique([source, rcptNo, reporter])
  @@index([corpCode])
  @@index([tradeType])
  @@index([reportedAt])
  @@map("insider_holding_changes")
}

// ====================================
// 공시 수집 로그 (M0 신규)
// ====================================

model DisclosureCollectionLog {
  id           Int       @id @default(autoincrement())
  startedAt    DateTime  @default(now()) // 수집 시작 시각
  endedAt      DateTime? // 수집 종료 시각 (RUNNING 중에는 null)
  bgnDe        String // 수집 시작일 (YYYYMMDD)
  endDe        String // 수집 종료일 (YYYYMMDD)
  fetchedCount Int       @default(0) // DART API 에서 받아온 총 건수
  newCount     Int       @default(0) // 신규 저장된 건수
  skippedCount Int       @default(0) // 중복으로 건너뛴 건수 (fetchedCount - newCount)
  failedCount  Int       @default(0) // 저장/매칭 오류 건수
  status       String    @default("RUNNING") // "RUNNING" | "SUCCESS" | "PARTIAL" | "FAILED"
  errorMessage String? // 실패 시 오류 메시지 (SUCCESS/PARTIAL 시 null)
  triggeredBy  String // "CRON" | "MANUAL"

  @@index([startedAt]) // 최근 N건 조회용
  @@index([status]) // 상태 필터 조회용
  @@index([triggeredBy])
  @@map("disclosure_collection_logs")
}

// ====================================
// AI 분석 태스크 식별자 enum (M3 신규)
// ====================================

enum AiTaskName {
  summary
  event_classification   @map("event-classification")
  persona_interpretation @map("persona-interpretation")
  position_thesis        @map("position-thesis")
}

// ====================================
// AI 비용 등급 enum (M3 신규)
// ====================================

enum AiCostLevel {
  L0
  L1
  L2
  L3
}

// ====================================
// AI 분석 결과 캐시 — 멱등 캐시 (M3 신규)
// ====================================

model DisclosureAnalysis {
  id         String      @id @default(cuid())
  rcpNo      String // 공시 접수번호 (FK → Disclosure.rcpNo)
  task       AiTaskName // AI 태스크 식별자
  level      AiCostLevel // 비용 등급
  resultJson Json // 태스크 실행 결과 JSON
  createdAt  DateTime    @default(now())

  // Relations
  disclosure Disclosure @relation(fields: [rcpNo], references: [rcpNo], onDelete: Cascade)

  @@unique([rcpNo, task]) // 멱등 캐시 복합 유니크
  @@index([rcpNo])
  @@index([task])
  @@index([createdAt])
  @@map("disclosure_analyses")
}

// ====================================
// Persona 해석 결과 (M3 신규)
// persona-interpretation 태스크 결과를 별도 테이블로 구체화
// ====================================

model PersonaAnalysis {
  id           String   @id @default(cuid())
  rcpNo        String   @unique // 공시 접수번호 (1:1, FK → Disclosure.rcpNo)
  resultJson   Json // PersonaInterpretation 전체 JSON
  philosophyId String? // (P-A) 연결된 투자자 철학 (nullable, FK → InvestorPhilosophy.philosophyId) — P-C에서 활용
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  disclosure Disclosure          @relation(fields: [rcpNo], references: [rcpNo], onDelete: Cascade)
  philosophy InvestorPhilosophy? @relation(fields: [philosophyId], references: [philosophyId], onDelete: SetNull)

  @@index([rcpNo])
  @@index([philosophyId])
  @@map("persona_analyses")
}

// ====================================
// AI 사용량 로그 — 비용 거버넌스 (M3 신규)
// ====================================

model AIUsageLog {
  id           String      @id @default(cuid())
  rcpNo        String // 공시 접수번호
  task         AiTaskName // AI 태스크 식별자
  level        AiCostLevel // 비용 등급
  model        String // 사용 LLM 모델명
  inputTokens  Int // 입력 토큰 수
  outputTokens Int // 출력 토큰 수
  costUsd      Float // 비용 (USD)
  // DAR-241: 멱등 캐시히트(비용0 재사용) 표식. true 행은 실호출 비용/L0 집계에서 제외하고
  // 캐시 적중률 관측에만 사용한다 — 재처리에서 AI 활용률 과소보고 방지.
  cacheHit     Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@index([rcpNo])
  @@index([task])
  @@index([level])
  @@index([createdAt])
  @@index([cacheHit])
  @@map("ai_usage_logs")
}

// ====================================
// 일봉 시세 (M4 신규)
// ====================================

model StockDailyPrice {
  id           String   @id @default(cuid())
  corpCode     String // DART 고유번호 (FK → Company.corpCode)
  stockCode    String // 종목코드 6자리
  tradeDate    String // 거래일 (YYYYMMDD)
  openPrice    Int // 시가
  highPrice    Int // 고가
  lowPrice     Int // 저가
  closePrice   Int // 종가
  volume       BigInt // 거래량
  tradingValue BigInt? // 거래대금 (원)
  createdAt    DateTime @default(now())

  company Company @relation(fields: [corpCode], references: [corpCode])

  @@unique([stockCode, tradeDate])
  @@index([corpCode])
  @@index([tradeDate])
  @@map("stock_daily_prices")
}

// ====================================
// 모의운용 합성 시세 (DAR-124, M10) — ★실시세 아님·실데이터 혼합 금지
// ====================================
//
// 환경 시계가 미래(2026)라 실 KRX 일봉이 없어 모의운용이 가격변동을 평가하지 못하는 문제를
// 결정적·재현가능 합성 일봉으로 해소한다(synthetic-price-feed.ts). 신뢰 원칙(불가침):
//   - 이 테이블은 '모의/시뮬레이션' 전용이다. 절대 실시세로 표시하지 않는다.
//   - 실데이터(StockDailyPrice)와 혼합하지 않는다 — 물리적으로 분리된 별도 테이블.
//   - 오직 PaperSimulation 만 읽는다. 기업 현재가/지표/신호 등 실가격 표시 경로는 이 테이블을
//     절대 참조하지 않는다(코드 경로 격리로 오인표시를 구조적으로 차단).
// Company FK 관계를 의도적으로 두지 않는다(격리·Company 모델 무변경). corpCode/stockCode 는
// 평문 컬럼으로 보관(고아 가능하나 모의 전용이라 무해).
model SimulatedDailyPrice {
  id         String   @id @default(cuid())
  corpCode   String // DART 고유번호(평문 — FK 관계 없음, 격리)
  stockCode  String // 종목코드 6자리
  tradeDate  String // 거래일 (YYYYMMDD)
  openPrice  Int // 합성 시가
  highPrice  Int // 합성 고가
  lowPrice   Int // 합성 저가
  closePrice Int // 합성 종가
  volume     BigInt // 합성 거래량
  /// 데이터 출처 라벨 — 항상 'SYNTHETIC'(실시세 오인 방지용 명시 라벨)
  source     String   @default("SYNTHETIC")
  createdAt  DateTime @default(now())

  @@unique([stockCode, tradeDate])
  @@index([corpCode])
  @@index([tradeDate])
  @@map("simulated_daily_prices")
}

// ====================================
// 기술지표 (M4 신규)
// ====================================

model TechnicalIndicator {
  id             String   @id @default(cuid())
  corpCode       String // DART 고유번호 (FK → Company.corpCode)
  stockCode      String // 종목코드 6자리
  tradeDate      String // 기준 거래일 (YYYYMMDD)
  ma5            Float? // 5일 이동평균
  ma20           Float? // 20일 이동평균
  ma60           Float? // 60일 이동평균
  ma120          Float? // 120일 이동평균
  rsi14          Float? // RSI (14일)
  macdLine       Float? // MACD 선 (12,26)
  macdSignal     Float? // MACD 신호선 (9)
  macdHistogram  Float? // MACD 히스토그램
  bollingerUpper Float? // 볼린저 상단 (20,2σ)
  bollingerMid   Float? // 볼린저 중단 (20 SMA)
  bollingerLower Float? // 볼린저 하단 (20,2σ)
  atr14          Float? // ATR (14일)
  vwap           Float? // VWAP (당일)
  volumeRatio20  Float? // 거래량비율 (20일 평균 대비)
  high52w        Int? // 52주 최고가
  low52w         Int? // 52주 최저가
  preDsclReturn  Float? // 공시 전 선행상승률 D-5~D-1 (%)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [corpCode], references: [corpCode])

  @@unique([stockCode, tradeDate])
  @@index([corpCode])
  @@index([tradeDate])
  @@map("technical_indicators")
}

// ====================================
// 시장 지수 (M4 신규)
// ====================================

model MarketIndex {
  id           String   @id @default(cuid())
  indexCode    String // 지수코드 (0001=KOSPI, 1001=KOSDAQ)
  indexName    String // 지수명
  tradeDate    String // 거래일 (YYYYMMDD)
  openIndex    Float // 시가지수
  highIndex    Float // 고가지수
  lowIndex     Float // 저가지수
  closeIndex   Float // 종가지수
  volume       BigInt? // 거래량
  tradingValue BigInt? // 거래대금
  createdAt    DateTime @default(now())

  @@unique([indexCode, tradeDate])
  @@index([tradeDate])
  @@map("market_indices")
}

// ====================================
// 종목 상태 (M4-C KRX 수집, DAR-8)
// ====================================

model StockStatus {
  stockCode           String   @id // Company.stockCode (6자리)
  tradeDate           String // 마지막 갱신 거래일 YYYYMMDD
  isTradingSuspended  Boolean  @default(false) // 거래정지
  isManagement        Boolean  @default(false) // 관리종목
  isInvestmentCaution Boolean  @default(false) // 투자주의
  isAbnormalSurge     Boolean  @default(false) // 이상급등(투자위험/경고)
  statusNote          String? // 사유 (예: "불성실공시법인 지정")
  updatedAt           DateTime @updatedAt

  @@index([tradeDate])
  @@map("stock_statuses")
}

// ====================================
// 시세 수집 로그 (M4-C KRX 수집, DAR-8)
// ====================================

model MarketDataCollectionLog {
  id           String    @id @default(cuid())
  tradeDate    String // 수집 대상 거래일 YYYYMMDD
  triggeredBy  String    @default("CRON") // "CRON" | "MANUAL"
  status       String    @default("RUNNING") // "RUNNING" | "SUCCESS" | "PARTIAL" | "FAILED"
  stockCount   Int       @default(0) // 수집 시도 종목 수
  savedCount   Int       @default(0) // 저장 성공 종목 수
  failedCount  Int       @default(0) // 실패 종목 수
  indexSaved   Boolean   @default(false) // 지수 저장 여부
  statusSaved  Boolean   @default(false) // 종목상태 저장 여부
  errorMessage String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  @@index([tradeDate])
  @@index([status])
  @@map("market_data_collection_logs")
}

// ====================================
// Event Study 결과 (M5 신규, DAR-9)
// ====================================

// 버킷 단위 집계 결과
model EventStudyResult {
  id String @id @default(cuid())

  // 집계 식별 키 (자연키)
  eventType  String // DisclosureEvent.eventType enum 값
  bucketKey  String // 버킷 식별자
  marketType String // "KOSPI" | "KOSDAQ" | "ALL"

  // 표본 정보
  sampleCount   Int // 집계 표본 수
  isSignificant Boolean // p < 0.05 기준
  tStatistic    Float? // t-통계량
  pValue        Float? // p-값
  variance      Float? // D+1 AR 분산 (과신 방지용)

  // D+N 평균 수익률 (종목 기준)
  avgReturnD1  Float // D0→D+1 단순 수익률 평균 (%)
  avgReturnD3  Float // D0→D+3 누적 수익률 평균 (%)
  avgReturnD5  Float // D0→D+5 누적 수익률 평균 (%)
  avgReturnD20 Float // D0→D+20 누적 수익률 평균 (%)

  // 시장 대비 초과수익 (Abnormal Return)
  avgArD1  Float // D+1 평균 AR (종목수익률 - 시장수익률)
  avgArD3  Float // D+3 누적 평균 AR
  avgArD5  Float // D+5 누적 평균 AR
  avgArD20 Float // D+20 누적 평균 AR

  // 분포 지표
  upProbD5       Float // D+5 기준 상승 확률 (0~1)
  crashProbD5    Float // D+5 기준 급락(-5% 이상) 확률 (0~1)
  avgMaxDrawdown Float // D0~D+20 평균 최대낙폭 MDD (%)

  // 거래량
  avgVolumeRatioD1 Float // D+1 거래량 / D-5 평균거래량 배율
  avgVolumeRatioD3 Float // D+3 평균

  // 메타
  calculatedAt DateTime @default(now())
  dataFromDate String // 집계 기간 시작 (YYYYMMDD)
  dataToDate   String // 집계 기간 종료 (YYYYMMDD)
  status       String   @default("READY")
  // "READY" | "INSUFFICIENT" | "CALCULATING" | "ERROR"

  @@unique([eventType, bucketKey, marketType])
  @@index([eventType])
  @@index([bucketKey])
  @@index([calculatedAt])
  @@map("event_study_results")
}

// 개별 이벤트 관측치 (집계 재현·디버깅용)
model EventStudyObservation {
  id        String @id @default(cuid())
  eventId   String // DisclosureEvent.id (논리 FK, Prisma relation 없음)
  rcpNo     String // Disclosure.rcpNo
  corpCode  String // Company.corpCode
  eventType String
  bucketKey String
  d0Date    String // 실제 D0 날짜 (YYYYMMDD)

  // D-5~D+20 일별 수익률·AR (JSON)
  dailyReturns Json // {"dm5":0.01, "d0":0.02, "d1":0.03, ...}
  dailyAR      Json // 일별 초과수익
  cumulativeAR Json // 누적 초과수익

  volumeRatios Json // {"d1":3.2, "d3":2.1}
  maxDrawdown  Float // D0~D+20 최대낙폭 (%)
  isUpD5       Boolean // D+5 기준 양수 수익 여부
  isCrashD5    Boolean // D+5 기준 -5% 이하 여부

  createdAt DateTime @default(now())

  @@index([eventType, bucketKey])
  @@index([rcpNo])
  @@index([corpCode])
  @@map("event_study_observations")
}

// ====================================
// 매수 신호 등급 enum (M6-A 신규, DAR-10)
// ====================================

enum SignalGrade {
  STRONG_BUY_CANDIDATE
  BUY_CANDIDATE
  WATCH
  NEUTRAL
  AVOID
  BLOCKED
}

// ====================================
// 매수 신호 결과 (M6-A 신규, DAR-10)
// ====================================

model TradingSignal {
  id String @id @default(cuid())

  // 공시 연결 (자연키 FK: Disclosure.rcpNo)
  rcpNo     String
  // 종목 연결 (자연키 FK: Company.corpCode)
  corpCode  String
  stockCode String // 종목코드 6자리 (조회 성능용 역정규화)

  // 이벤트
  eventType   String // DisclosureEvent.eventType enum 값
  subCategory String? // 이벤트 세분류 (예: 'salesRatio_20pct_above')

  // Persona
  persona String // 'GROWTH' | 'VALUE' | 'MOMENTUM' | 'EVENT_DRIVEN'

  // Buy Score 결과
  buyScore Int // -100 ~ 100 (정수)
  signal   SignalGrade

  // DAR-91: calibration 등급 보정계수 환류 confidence (점수/confidence 한정, 실주문 무관).
  // 원본 buyScore 보존 — 백테스트 실현 적중률이 등급 기대 미만(과대평가)일 때만 디스카운트.
  // 가산형 nullable: 보정 미적용(계수 1.0 폴백)·기존 행은 null/원값. 임계값 불변.
  calibratedConfidence Int? // -100 ~ 100 (정수). null = 보정 정보 없음

  // 컴포넌트별 점수 (추적·디버깅용)
  scoreBreakdown Json // { disclosureEvent, keyMetric, personaFit, historicalEvent, chart, volumeLiquidity, marketSector }
  riskPenalty    Int // 차감된 패널티 합계

  // 진입 조건
  entryConditionMet   String[] // 충족된 조건 label 목록
  entryConditionUnmet String[] // 미충족 조건 label 목록
  entryReady          Boolean  @default(false)

  // 리스크 요인 (human-readable)
  riskFactors String[]

  // AI Phase 4 DisclosureAnalysis 참조 요약 (새 AI 호출 없음)
  signalSummary String?

  // 차단 사유 (signal=BLOCKED 시)
  blockedReason String?

  // DAR-323: '왜 강한 신호가 아닌지' 억제 사유 enum 문자열(가독성·정직성).
  // EVENT_STUDY_DARK | INDICATORS_MISSING | UNMODELED_EVENT | NO_POLARITY | GENUINELY_NEUTRAL
  // BUY 이상·BLOCKED·기존 행 = null. 점수 산식 무관(순수 파생 표시값).
  suppressionReason String?

  // 유효 시간
  validUntil DateTime?

  // 상태
  isNotified Boolean   @default(false)
  notifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  disclosure     Disclosure      @relation(fields: [rcpNo], references: [rcpNo])
  company        Company         @relation(fields: [corpCode], references: [corpCode])
  positionThesis PositionThesis?
  paperTrades    PaperTrade[]

  // DAR-125: 원천 멱등 자연키. corpCode+rcpNo+eventType(이슈 요청 키) + persona.
  //   DisclosureEvent.rcpNo 가 @unique(공시:이벤트 1:1)라 corpCode·eventType 은
  //   rcpNo 에 함수종속 → 기존 (rcpNo, persona) 와 동치이나, 이벤트타입을 키에
  //   명시해 향후 1:N 확장에도 중복이 원천 차단되도록 강화한다. persona 는 4종
  //   페르소나별 독립 분석(상이한 buyScore·personaType 필터)이므로 보존(손실 금지).
  @@unique([corpCode, rcpNo, eventType, persona])
  @@index([corpCode])
  @@index([stockCode])
  @@index([signal])
  @@index([rcpNo])
  @@index([createdAt])
  @@index([persona])
  @@index([entryReady])
  @@map("trading_signals")
}

// ====================================
// Position Thesis 생명주기 상태 enum (M7 신규, DAR-11)
// ====================================

enum ThesisStatus {
  ACTIVE // 논리 유효, 추적 중
  INVALIDATED // 무효 조건 충족 → Exit Engine 대상
  CLOSED // 포지션 청산 완료
}

// ====================================
// Position Thesis — 매수 논리 저장소 (M7 신규, DAR-11)
//
// 매수 신호(TradingSignal)당 1:1 자동 생성.
// AI 금지영역: 생성·평가는 순수 Rule 기반. exitRules·maxWeight는 AI 변경 불가.
// ====================================

model PositionThesis {
  id String @id @default(cuid())

  // 매수 신호 연결 (1:1, FK → TradingSignal.id)
  tradingSignalId String @unique

  // 공시 자연키 연결 (FK → Disclosure.rcpNo)
  rcpNo String

  // 종목 연결 (FK → Company.corpCode, 조회 성능)
  corpCode String

  // 매수 논리
  entryReason   String // 진입 사유 (한 문장 요약)
  initialThesis Json // 근거 항목 배열 (string[])

  // 무효 조건 — 기계 평가 가능한 구조화 형태 (추상 자연어 금지)
  // 스키마: InvalidCondition[] — invalid-condition.types.ts 참조
  // 예: [{"type":"PRICE_BELOW","value":45000}, {"type":"AMENDMENT_NEGATIVE"}]
  invalidConditions Json

  // 청산 룰 — Rule 기반, AI 변경 불가
  // 예: [{"type":"STOP_LOSS_PCT","value":8}, {"type":"MAX_HOLD_DAYS","value":20}]
  exitRules Json

  // 최대 비중 (%) — 하드룰, Engine5 Risk가 최종 강제
  maxWeight Float @default(5.0)

  // 생명주기 상태
  status ThesisStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tradingSignal TradingSignal @relation(fields: [tradingSignalId], references: [id])
  disclosure    Disclosure    @relation(fields: [rcpNo], references: [rcpNo])
  company       Company       @relation(fields: [corpCode], references: [corpCode])
  position      Position? // optional 1:1 back-relation from Position
  paperTrades   PaperTrade[]

  @@index([corpCode])
  @@index([rcpNo])
  @@index([status])
  @@index([createdAt])
  @@map("position_theses")
}

// ====================================
// M8 — Portfolio & Exit Engine (DAR-12)
// AI 금지영역: Exit Score·트리거·5액션 순수 Rule 기반. AI 개입 0.
// ====================================

enum PositionStatus {
  OPEN
  CLOSED
  PARTIAL
}

enum ExitTriggerType {
  STOP_LOSS
  TAKE_PROFIT
  THESIS_INVALIDATED
  TIME_LIMIT
  CHART_BREAKDOWN
  REBALANCING
}

enum ExitAction {
  HOLD
  WATCH
  REDUCE
  EXIT
  BLOCK_REBUY
}

model Portfolio {
  id                   String   @id @default(cuid())
  userId               String
  name                 String   @default("기본 포트폴리오")
  currency             String   @default("KRW")
  isActive             Boolean  @default(true)
  maxSinglePositionPct Float    @default(10.0)
  maxSectorPct         Float    @default(30.0)
  maxDailyLossPct      Float    @default(2.0)
  maxWeeklyLossPct     Float    @default(5.0)
  stopLossGlobalPct    Float    @default(15.0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions     Position[]
  riskSnapshots PortfolioRiskSnapshot[]
  funnelDaily   SignalEntryFunnelDaily[]

  @@index([userId])
  @@map("portfolios")
}

model Position {
  id               String  @id @default(cuid())
  portfolioId      String
  corpCode         String
  stockCode        String
  positionThesisId String? @unique

  entryDate   DateTime
  entryPrice  Float
  quantity    Int
  entryAmount Float

  currentPrice     Float?
  currentValue     Float?
  unrealizedPnl    Float?
  unrealizedPnlPct Float?

  stopLossPct   Float?
  takeProfitPct Float?
  maxHoldDays   Int?

  highestPrice Float?
  highestAt    DateTime?

  status   PositionStatus @default(OPEN)
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolio      Portfolio               @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  company        Company                 @relation(fields: [corpCode], references: [corpCode])
  positionThesis PositionThesis?         @relation(fields: [positionThesisId], references: [id])
  dailySnapshots PositionDailySnapshot[]
  exitSignals    ExitSignal[]

  // DAR-122: 포트폴리오별 종목당 OPEN 포지션 1건 강제(데이터 레벨 중복 근절).
  // 부분 유니크 인덱스 `positions_portfolioId_stockCode_open_key`
  //   = UNIQUE (portfolioId, stockCode) WHERE status='OPEN'.
  // Prisma 스키마는 WHERE 조건부 유니크를 표현할 수 없어 raw 마이그레이션
  //   (20260608000000_dar122_position_open_unique)으로만 관리한다. CLOSED 이력은 다수 허용.
  @@index([portfolioId, status])
  @@index([corpCode])
  @@index([stockCode])
  @@map("positions")
}

model PositionDailySnapshot {
  id           String @id @default(cuid())
  positionId   String
  snapshotDate String

  openPrice  Float?
  closePrice Float?
  highPrice  Float?
  lowPrice   Float?
  volume     BigInt?

  ma5   Float?
  ma20  Float?
  ma60  Float?
  rsi14 Float?
  atr14 Float?
  vwap  Float?

  quantity         Int
  positionValue    Float
  unrealizedPnl    Float
  unrealizedPnlPct Float

  exitScore  Int?
  exitAction String?

  // DAR-76: 철학 스타일별 모의운용 분기 — 스타일 태그(가산형, nullable).
  // 단일 시뮬(스타일 없음)은 null 유지 → 기존 데이터·집계 무손상. styleTags 패턴(investor_philosophies) 계승.
  styleTag String?

  createdAt DateTime @default(now())

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([positionId, snapshotDate])
  @@index([positionId, snapshotDate])
  @@index([styleTag])
  @@map("position_daily_snapshots")
}

model ExitSignal {
  id         String @id @default(cuid())
  positionId String
  checkTime  String

  lossRiskScore         Int @default(0)
  thesisBreakScore      Int @default(0)
  chartBreakScore       Int @default(0)
  disclosureRiskScore   Int @default(0)
  overweightScore       Int @default(0)
  timeExceededScore     Int @default(0)
  positiveMomentumBonus Int @default(0)

  exitScore    Int
  exitAction   ExitAction
  triggerType  ExitTriggerType?
  triggerTypes String[]

  scoreDetail Json

  triggerRcpNo String?

  aiExplanation String?
  aiUsed        Boolean @default(false)

  isAcknowledged Boolean   @default(false)
  acknowledgedAt DateTime?
  userAction     String?

  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())

  position   Position    @relation(fields: [positionId], references: [id], onDelete: Cascade)
  disclosure Disclosure? @relation(fields: [triggerRcpNo], references: [rcpNo])

  @@index([positionId, checkedAt])
  @@index([exitAction])
  @@index([exitScore])
  @@index([triggerRcpNo])
  @@map("exit_signals")
}

model PortfolioRiskSnapshot {
  id           String @id @default(cuid())
  portfolioId  String
  snapshotDate String

  totalValue       Float
  cashAmount       Float?
  unrealizedPnl    Float
  unrealizedPnlPct Float

  topPositionPct    Float
  topSectorPct      Float?
  openPositionCount Int

  dailyPnl     Float?
  dailyPnlPct  Float?
  weeklyPnl    Float?
  weeklyPnlPct Float?

  riskLevel        String  @default("NORMAL")
  hardRuleBreached Boolean @default(false)
  hardRuleDetail   String?

  createdAt DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, snapshotDate])
  @@index([portfolioId, snapshotDate])
  @@map("portfolio_risk_snapshots")
}

// ====================================
// DAR-109: 신호→진입 퍼널 일별 계측 (engine5 모의운용)
//
// 졸업 표본(G1/G2/G5)을 막던 PrismaSimulationAdapter write 실구현과 함께,
// '당일 생성 신호 수 → 진입 후보 통과 수 → 실제 체결 수'를 일별로 누적 기록한다.
// fill/adoption rate(체결률·채택률)는 read 시 파생 산출(저장하지 않음 — 단일 출처).
// ★ 모의 전용 — 실주문 무관. AI 미개입(순수 카운트). 멱등키 (portfolioId, tradeDate).
// ====================================
model SignalEntryFunnelDaily {
  id          String @id @default(cuid())
  portfolioId String
  tradeDate   String // 거래일 (YYYYMMDD)

  signalsGenerated Int // 당일 생성된 매수 신호 수 (퍼널 최상단)
  candidatesPassed Int // 진입 후보 선정(보유중복·슬롯 필터) 통과 수
  filled           Int // 실제 모의 체결(신규 매수) 수

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, tradeDate])
  @@index([portfolioId, tradeDate])
  @@map("signal_entry_funnel_daily")
}

// ====================================
// M9-A: 백테스트 엔진 (DAR-13)
// AI 금지영역: 백테스트 로직·체결 시뮬은 순수 Rule. AI 개입 0.
// ====================================

enum BacktestStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ExitReason {
  TAKE_PROFIT
  STOP_LOSS
  TRAILING_STOP
  THESIS_BREAK
  MAX_HOLD_DAYS
  CHART_BREAK
  LIQUIDITY_EXIT
  FORCE_EXIT
}

model BacktestRun {
  id          String  @id @default(cuid())
  name        String
  description String?

  // 전략 파라미터 JSON
  strategyParams Json

  // 테스트 기간
  startDate DateTime
  endDate   DateTime
  universe  String // "WATCHLIST" | "KOSPI200" | "ALL_LISTED"

  // 비용 파라미터
  commissionRate Decimal @db.Decimal(6, 5)
  taxRate        Decimal @db.Decimal(6, 5)
  slippagePct    Decimal @db.Decimal(6, 5)

  // 실행 상태
  status       BacktestStatus @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?

  // 성과 요약 (완료 후 저장)
  summary Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trades BacktestTrade[]

  @@index([status])
  @@index([startDate, endDate])
  @@map("backtest_runs")
}

model BacktestTrade {
  id            String @id @default(cuid())
  backtestRunId String

  // 공시 연결 (lookahead bias 방지: rcpDt 기준 진입만 허용)
  disclosureRcpNo String // FK → Disclosure.rcpNo
  corpCode        String // FK → Company.corpCode
  stockCode       String

  eventType String
  persona   String

  // 진입 (다음 거래일 시가 진입 — lookahead bias 방지 핵심)
  disclosureAt  DateTime // 공시 실제 접수 시각
  isAfterMarket Boolean // 장마감(15:30) 후 공시 여부
  entryDate     DateTime // 실제 진입 거래일
  entryPrice    Decimal  @db.Decimal(12, 2)
  entryShares   Int
  entryValue    Decimal  @db.Decimal(16, 2)

  // 매도
  exitDate   DateTime?
  exitPrice  Decimal?    @db.Decimal(12, 2)
  exitShares Int?
  exitValue  Decimal?    @db.Decimal(16, 2)
  exitReason ExitReason?

  // 비용
  commission Decimal @default(0) @db.Decimal(12, 2)
  tax        Decimal @default(0) @db.Decimal(12, 2)
  slippage   Decimal @default(0) @db.Decimal(12, 2)

  // 성과
  grossPnl  Decimal? @db.Decimal(12, 2)
  netPnl    Decimal? @db.Decimal(12, 2)
  returnPct Decimal? @db.Decimal(8, 4)
  holdDays  Int?

  // 현실 제약 플래그
  wasLimitUp          Boolean  @default(false)
  wasLimitDown        Boolean  @default(false)
  wasTradingSuspended Boolean  @default(false)
  wasAdminStock       Boolean  @default(false)
  isPartialFill       Boolean  @default(false)
  fillRate            Decimal? @db.Decimal(5, 4)
  lowLiquidityFlag    Boolean  @default(false)

  // 진입 시점 점수 스냅샷
  buyScoreSnapshot  Int?
  exitScoreSnapshot Int?

  createdAt DateTime @default(now())

  backtestRun BacktestRun @relation(fields: [backtestRunId], references: [id], onDelete: Cascade)

  @@index([backtestRunId])
  @@index([corpCode])
  @@index([eventType])
  @@index([persona])
  @@index([entryDate])
  @@index([returnPct])
  @@map("backtest_trades")
}

// ====================================
// M10 — Engine5 Paper Trade (DAR-16)
// AI 금지영역: 체결·Risk 로직 순수 Rule. AI 개입 0.
// ====================================

enum PaperTradeStatus {
  PENDING // 주문 대기
  FILLED // 완전 체결
  PARTIAL // 부분 체결
  CANCELLED // 취소
  REJECTED // 거부 (Risk 한도 초과)
}

enum PaperTradeDirection {
  BUY
  SELL
}

model PaperTrade {
  id String @id @default(cuid())

  // 종목 (FK → Company.corpCode)
  corpCode  String
  stockCode String

  // 방향·수량
  direction     PaperTradeDirection
  orderedShares Int // 주문 수량
  filledShares  Int                 @default(0) // 체결 수량
  fillRate      Decimal             @default(0) @db.Decimal(5, 4) // 체결률 0~1

  // 가격
  entryPrice  Decimal  @db.Decimal(12, 2) // 진입 기준가 (다음거래일 시가)
  filledPrice Decimal? @db.Decimal(12, 2) // 실제 체결가 (슬리피지 반영)

  // 비용 (KRW 절대값)
  commission Decimal @default(0) @db.Decimal(12, 2) // 수수료
  tax        Decimal @default(0) @db.Decimal(12, 2) // 세금 (매도 시 증권거래세)
  slippage   Decimal @default(0) @db.Decimal(12, 2) // 슬리피지 비용

  // 손익 (체결 완료 후)
  grossPnl  Decimal? @db.Decimal(12, 2)
  netPnl    Decimal? @db.Decimal(12, 2)
  returnPct Decimal? @db.Decimal(8, 4)

  // 상태
  status PaperTradeStatus @default(PENDING)

  // 메타
  entryDate DateTime // 체결 예정 거래일 (다음거래일 시가 진입)
  filledAt  DateTime? // 실제 체결 시각

  // 신호·논리 연결 (optional — fixture 테스트에서는 null 허용)
  tradingSignalId  String?
  positionThesisId String?

  // DAR-76: 철학 스타일별 모의운용 분기 — 스타일 태그(가산형, nullable).
  // 단일 시뮬(스타일 없음)은 null 유지 → 기존 데이터·집계 무손상. styleTags 패턴(investor_philosophies) 계승.
  styleTag String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [corpCode], references: [corpCode])
  tradingSignal  TradingSignal?  @relation(fields: [tradingSignalId], references: [id])
  positionThesis PositionThesis? @relation(fields: [positionThesisId], references: [id])

  @@index([corpCode])
  @@index([stockCode])
  @@index([status])
  @@index([entryDate])
  @@index([tradingSignalId])
  @@index([positionThesisId])
  @@index([styleTag])
  @@map("paper_trades")
}

// ====================================
// M11 — Engine5 Risk Engine (DAR-18)
// AI 금지영역: Risk 판정은 순수 Rule. AI 개입 0.
// ====================================

enum OrderRequestStatus {
  PENDING // 위험성 검사 전
  APPROVED // 위험성 검사 통과
  REJECTED // 위험성 검사 거부 (하드룰 위반)
  KILLED // Kill Switch에 의해 차단
  EXECUTED // 체결 완료
  CANCELLED // 취소
}

enum OrderSide {
  BUY
  SELL
}

enum AuditAction {
  ORDER_REQUESTED // 주문 요청
  RISK_PASSED // 위험성 검사 통과
  RISK_REJECTED // 위험성 검사 거부
  KILL_SWITCH_FIRED // Kill Switch 발동
  ORDER_EXECUTED // 체결 완료
  ORDER_CANCELLED // 취소
  KILL_SWITCH_SET // Kill Switch 수동 설정
  KILL_SWITCH_RESET // Kill Switch 수동 해제
}

model OrderRequest {
  id             String @id @default(cuid())
  idempotencyKey String @unique // 멱등 주문키 (중복 방지)

  corpCode        String
  stockCode       String
  side            OrderSide
  requestedShares Int
  limitPrice      Decimal?  @db.Decimal(12, 2) // null = 시장가

  // Risk 판정 결과
  status          OrderRequestStatus @default(PENDING)
  rejectionReason String? // 거부 사유 (하드룰 위반 내용)

  // 스냅샷 (판정 시점 포트폴리오 상태)
  capitalSnapshot    Decimal @db.Decimal(14, 2) // 판정 시점 총자산
  dailyLossSnapshot  Decimal @db.Decimal(12, 2) // 판정 시점 당일 손실
  weeklyLossSnapshot Decimal @db.Decimal(12, 2) // 판정 시점 주간 손실
  positionWeightSnap Decimal @db.Decimal(5, 4) // 판정 시점 종목 비중

  // Buy Score 스냅샷 (Risk veto 증적 — AI가 긍정이어도 Risk가 거부하면 거부 기록)
  buyScoreSnapshot Int?

  // 실행 연결
  paperTradeId String?
  executionId  String? // OrderExecution FK

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company           @relation(fields: [corpCode], references: [corpCode])
  execution OrderExecution?   @relation(fields: [executionId], references: [id])
  auditLogs TradingAuditLog[]

  @@index([corpCode])
  @@index([stockCode])
  @@index([status])
  @@index([createdAt])
  @@map("order_requests")
}

model OrderExecution {
  id String @id @default(cuid())

  corpCode       String
  stockCode      String
  side           OrderSide
  executedShares Int
  executedPrice  Decimal   @db.Decimal(12, 2)
  commission     Decimal   @default(0) @db.Decimal(12, 2)
  tax            Decimal   @default(0) @db.Decimal(12, 2)
  slippage       Decimal   @default(0) @db.Decimal(12, 2)
  netAmount      Decimal   @db.Decimal(14, 2) // 체결금액 - 비용

  executedAt DateTime
  createdAt  DateTime @default(now())

  company       Company           @relation(fields: [corpCode], references: [corpCode])
  orderRequests OrderRequest[]
  auditLogs     TradingAuditLog[]

  @@index([corpCode])
  @@index([executedAt])
  @@map("order_executions")
}

model TradingAuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  actorKind String // "SYSTEM" | "RISK_ENGINE" | "KILL_SWITCH" | "USER"
  summary   String // 한줄 요약

  // 연결 (nullable — Kill Switch 수동 조작 등 주문 없이도 기록)
  orderRequestId String?
  executionId    String?

  // 상세 메타 (JSON)
  meta Json?

  createdAt DateTime @default(now())

  orderRequest OrderRequest?   @relation(fields: [orderRequestId], references: [id])
  execution    OrderExecution? @relation(fields: [executionId], references: [id])

  @@index([action])
  @@index([orderRequestId])
  @@index([executionId])
  @@index([createdAt])
  @@map("trading_audit_logs")
}

model KillSwitchState {
  id            String    @id @default(cuid())
  isActive      Boolean   @default(false)
  reason        String? // 발동 사유
  triggeredBy   String    @default("SYSTEM") // "SYSTEM" | "USER"
  activatedAt   DateTime?
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("kill_switch_states")
}

// ====================================
// Persona 철학 엔진 P-A (DAR-48)
// 유명 투자자 철학을 구조화·정량화하여 저장. AI 미개입(순수 데이터/구조).
// 로드맵: docs/roadmap/cc-persona-philosophy-engine.md §2·§4 P-A
// ====================================

// 정량 지표 비교 연산자
enum PhilosophyMetricOperator {
  GT // ≥ (이상)
  LT // ≤ (이하)
  EQ // = (같음/충족)
  RANGE // 범위 [min, max]
}

// 철학 출처 유형
enum PhilosophySourceType {
  BOOK
  SHAREHOLDER_LETTER
  INTERVIEW
  PUBLIC_STATEMENT
}

// 유명 투자자 철학 (마스터)
// philosophyId 자연키(예: 'BUFFETT', 'LYNCH')로 식별 — P-B 스코어러가 참조.
model InvestorPhilosophy {
  philosophyId     String   @id // 고유 식별자 자연키 (예: 'BUFFETT', 'LYNCH', 'GREENBLATT', 'DRUCKENMILLER')
  investorName     String // 유명 투자자 이름
  styleTags        String[] // 스타일 태그 (예: ['VALUE','MOAT','LONG_TERM']) — 기존 4 persona(VALUE/GROWTH/MOMENTUM/EVENT_DRIVEN)와 연계 가능
  corePrinciples   String[] // 핵심 원칙 요약 (3~7개)
  applicableAssets String[] // 적용 자산군 (예: ['KR_STOCK','US_STOCK','CRYPTO'])
  checklistItems   String[] // 투자 전 체크리스트
  riskProfile      String // 리스크 성향 (예: '보수적', '공격적·집중투자')
  scoreFormula     String? // 스코어 산식 설명 (0~100 환산식, 참고용)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  metrics         PhilosophyMetric[]
  sources         PhilosophySource[]
  personaAnalyses PersonaAnalysis[]

  @@index([investorName])
  @@map("investor_philosophies")
}

// 철학별 정량 지표 매핑 (ROE·부채비율·PER·해자 등)
model PhilosophyMetric {
  id           String                   @id @default(cuid())
  philosophyId String // FK → InvestorPhilosophy
  metricKey    String // 지표 키 (예: 'ROE', 'DEBT_RATIO', 'PER', 'MOAT_SCORE')
  operator     PhilosophyMetricOperator // 비교 연산자
  threshold    Float // 기준값 (RANGE의 경우 하한)
  thresholdMax Float? // RANGE 상한 (operator=RANGE일 때만 사용)
  weight       Float // 가중치 0~1 (해당 철학 내 합산 = 1)
  description  String // 지표 설명

  philosophy InvestorPhilosophy @relation(fields: [philosophyId], references: [philosophyId], onDelete: Cascade)

  @@unique([philosophyId, metricKey]) // 철학 내 지표 키 유일 — 시드 멱등성 보장
  @@index([philosophyId])
  @@map("philosophy_metrics")
}

// 철학 출처 (공개 자료 기반)
model PhilosophySource {
  id           String               @id @default(cuid())
  philosophyId String // FK → InvestorPhilosophy
  type         PhilosophySourceType // 출처 유형
  title        String // 자료 제목
  year         Int // 발간/공개 연도
  url          String? // 공개 URL (주주서한 등)

  philosophy InvestorPhilosophy @relation(fields: [philosophyId], references: [philosophyId], onDelete: Cascade)

  @@unique([philosophyId, title]) // 철학 내 출처 제목 유일 — 시드 멱등성 보장
  @@index([philosophyId])
  @@map("philosophy_sources")
}

// ====================================
// 재무지표 (DAR-52 신규) — DART 정기공시 재무제표 수집
// ====================================

// 기업 재무지표 — DART 단일회사 전체 재무제표(fnlttSinglAcntAll) 기반.
// 자연키: corpCode + 기준연도(bsnsYear) + 보고서코드(reprtCode) + 재무제표구분(fsDiv).
// AI 미개입(순수 데이터/Rule 파생비율). Persona P-B 스코어러·BuyScore keyMetric이 읽는다.
model CompanyFinancial {
  id String @id @default(cuid())

  // ── 자연키 ──────────────────────────────────────────────────
  corpCode   String // DART 고유번호 (FK → Company.corpCode)
  stockCode  String? // 종목코드 6자리 (조회 성능용 역정규화)
  bsnsYear   String // 사업연도 (예: '2025')
  reprtCode  String // 보고서코드 11011(연간)/11012(반기)/11013(1Q)/11014(3Q)
  fsDiv      String  @default("CFS") // CFS(연결) | OFS(별도)

  // ── 핵심 지표 (원, BigInt — 조 단위 금액 안전 저장) ───────────
  revenue          BigInt? // 매출액
  operatingProfit  BigInt? // 영업이익
  netIncome        BigInt? // 당기순이익
  totalAssets      BigInt? // 자산총계
  totalLiabilities BigInt? // 부채총계
  totalEquity      BigInt? // 자본총계

  // ── 주당 지표 ────────────────────────────────────────────────
  eps Float? // 기본주당이익 (원)
  bps Float? // 주당순자산 (원) — 발행주식수 확보 시 보강

  // ── 파생 비율 (%) — 재무제표만으로 산출 ──────────────────────
  roe       Float? // 자기자본이익률 = 순이익/자본 × 100
  roa       Float? // 총자산이익률 = 순이익/자산 × 100
  debtRatio Float? // 부채비율 = 부채/자본 × 100

  // ── 시세 결합 파생 (가능 시 보강, 기본 null) ─────────────────
  per Float? // 주가수익비율 — 시세 결합 필요
  pbr Float? // 주가순자산비율 — 시세 결합 필요

  // ── 다년 시계열 성장률 (%) — DAR-93. 직전 기간 적재 후 산출·영속, 결측 시 null ──
  revenueGrowthYoY         Float? // 매출 YoY 성장률 (전년 동기 대비)
  operatingProfitGrowthYoY Float? // 영업이익 YoY 성장률
  epsGrowthYoY             Float? // EPS YoY 성장률
  revenueGrowthQoQ         Float? // 매출 QoQ 성장률 (직전 기간 대비, 누적기준)
  operatingProfitGrowthQoQ Float? // 영업이익 QoQ 성장률
  epsGrowthQoQ             Float? // EPS QoQ 성장률

  // ── 메타 ────────────────────────────────────────────────────
  rceptNo   String? // 원천 공시 접수번호 (추적용)
  currency  String  @default("KRW")
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [corpCode], references: [corpCode])

  @@unique([corpCode, bsnsYear, reprtCode, fsDiv]) // 멱등 upsert 자연키
  @@index([corpCode])
  @@index([bsnsYear])
  @@map("company_financials")
}

// 재무지표 수집 실행 로그 — 수집 서비스 멱등성·관측성 (MarketDataCollectionLog 패턴).
model FinancialCollectionLog {
  id           String    @id @default(cuid())
  bsnsYear     String // 수집 대상 사업연도
  reprtCode    String // 보고서코드
  fsDiv        String    @default("CFS")
  triggeredBy  String    @default("MANUAL") // "MANUAL" | "CRON"
  status       String    @default("RUNNING") // "RUNNING" | "SUCCESS" | "PARTIAL" | "FAILED"
  targetCount  Int       @default(0) // 수집 대상 기업 수
  savedCount   Int       @default(0) // upsert 성공 기업 수
  skippedCount Int       @default(0) // 데이터 없음/스킵 수
  failedCount  Int       @default(0) // 실패 수
  errorMessage String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  @@index([bsnsYear])
  @@index([status])
  @@map("financial_collection_logs")
}

// ====================================
// 크론 실행 헬스 로그 — 수집 안전망 (DAR-110, 패널 v5 #5)
// ====================================
// 도메인별 *CollectionLog(공시·재무·시세)와 별개로, 자체 로그가 없던 경량 크론
// (신호생성·모의운용·내부자수집·파싱재처리 등)의 마지막 성공시각/처리건수를 통일 기록한다.
// 각 @Cron 본문을 try/finally 로 감싸 성공/실패/건수를 남기는 단일 출처.
// freshness(데이터 신선도) 판정의 입력 — '조용히 멈춘' 수집을 인지하기 위한 메타 전용.
// AI·실주문·KRX 무관(수집 메타만). 기존 도메인 로그·크론 거동 불변(가산 테이블).
model CronRunLog {
  id           String    @id @default(cuid())
  jobKey       String // 크론 식별 키 (예: "signal.generate" | "paper.simulation" | "insider.daily" | "parse.retry")
  status       String    @default("RUNNING") // "RUNNING" | "SUCCESS" | "FAILED" | "SKIPPED"
  itemCount    Int       @default(0) // 처리/신규 건수 (도메인별 의미)
  durationMs   Int? // 실행 소요(ms). 미완료 시 null
  errorMessage String? // 실패 시 메시지 (SUCCESS/SKIPPED 시 null)
  triggeredBy  String    @default("CRON") // "CRON" | "MANUAL"
  startedAt    DateTime  @default(now())
  finishedAt   DateTime? // 종료 시각 (RUNNING 중에는 null)

  @@index([jobKey, startedAt]) // 잡별 최근 실행 조회용
  @@index([jobKey, status, finishedAt]) // 잡별 최근 성공 조회용
  @@index([status])
  @@map("cron_run_logs")
}
