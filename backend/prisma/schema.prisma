model Position {
  id               String  @id @default(cuid())
  portfolioId      String
  corpCode         String
  stockCode        String
  positionThesisId String? @unique

  entryDate   DateTime
  entryPrice  Float
  quantity    Int
  entryAmount Float

  // DAR-433: 진입가가 어느 시세 소스로 기록됐는지(REALTIME|REAL|SYNTHETIC). 청산/평가가
  //   진입과 다른 소스로 떨어지는 cross-source 가짜손절을 막기 위해, 평가 시 진입 소스로 정렬한다.
  //   nullable — 레거시 포지션(이 컬럼 이전 진입)은 null → 정렬 가드 면제(기존 동작 보존·회귀 0).
  entryPriceSource String?

  currentPrice     Float?
  currentValue     Float?
  unrealizedPnl    Float?
  unrealizedPnlPct Float?

  stopLossPct   Float?
  takeProfitPct Float?
  maxHoldDays   Int?

  highestPrice Float?
  highestAt    DateTime?

  status   PositionStatus @default(OPEN)
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolio      Portfolio               @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  company        Company                 @relation(fields: [corpCode], references: [corpCode])
  positionThesis PositionThesis?         @relation(fields: [positionThesisId], references: [id])
  dailySnapshots PositionDailySnapshot[]
  exitSignals    ExitSignal[]

  // DAR-122: 포트폴리오별 종목당 OPEN 포지션 1건 강제(데이터 레벨 중복 근절).
  // 부분 유니크 인덱스 `positions_portfolioId_stockCode_open_key`
  //   = UNIQUE (portfolioId, stockCode) WHERE status='OPEN'.
  // Prisma 스키마는 WHERE 조건부 유니크를 표현할 수 없어 raw 마이그레이션
  //   (20260608000000_dar122_position_open_unique)으로만 관리한다. CLOSED 이력은 다수 허용.
  @@index([portfolioId, status])
  @@index([corpCode])
  @@index([stockCode])
  @@map("positions")
}

