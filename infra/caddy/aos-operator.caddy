admin.168.138.198.152.nip.io {
    encode zstd gzip

    header {
        -Server
        Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
        Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
        Referrer-Policy "no-referrer"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }

    @immutable_assets path /assets/*
    header @immutable_assets Cache-Control "public, max-age=31536000, immutable"

    @spa_entry path / /index.html
    header @spa_entry Cache-Control "no-cache"

    handle /api/* {
        reverse_proxy 127.0.0.1:3000
    }

    handle {
        root * /var/www/aos-operator/current
        try_files {path} /index.html
        file_server
    }
}
