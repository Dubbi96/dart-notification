# 백엔드 API 주소
# - 시뮬레이터/에뮬레이터: http://localhost:3000/api (안드로이드 에뮬은 10.0.2.2)
# - Expo Go(실기기): 개발 PC의 LAN IP 사용 (예: http://192.168.0.17:3000/api)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# 카카오 REST API 키 (백엔드 KAKAO_REST_API_KEY 와 동일 앱)
EXPO_PUBLIC_KAKAO_REST_API_KEY=your-kakao-rest-api-key

EXPO_PUBLIC_APP_ENV=development
