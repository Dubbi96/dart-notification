{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": [
    "@typescript-eslint",
    "react",
    "react-hooks",
    "react-native",
    "import"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended",
    "plugin:react-native/all",
    "prettier"
  ],
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "env": {
    "react-native/react-native": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off",
    "react-native/no-inline-styles": "warn",
    "react-native/no-color-literals": "warn",
    "react-native/no-raw-text": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "@typescript-eslint/explicit-function-return-type": "off",
    "import/order": [
      "warn",
      {
        "groups": ["builtin", "external", "internal", "parent", "sibling", "index", "type"],
        "pathGroups": [
          {
            "pattern": "@{components,theme,hooks,services,stores,app-types,utils}/**",
            "group": "internal"
          }
        ],
        "newlines-between": "always"
      }
    ],
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "react-native/sort-styles": "off",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "JSXAttribute[name.name='refreshControl'] JSXElement > JSXOpeningElement[name.name!='RefreshControl']",
        "message": "refreshControl prop에 커스텀 컴포넌트 금지: RN 0.85 Fabric(Android)에서 FlatList/ScrollView 콘텐츠가 통째로 미렌더됩니다. FlatList는 refreshing/onRefresh props를, ScrollView는 RN 코어 <RefreshControl>을 직접 사용하세요. 근거: docs/mobile-cross-platform-issues.md #1."
      }
    ]
  },
  "overrides": [
    {
      "files": ["__tests__/**/*.ts", "__tests__/**/*.tsx", "jest.config.js"],
      "env": {
        "jest": true,
        "node": true
      }
    }
  ],
  "ignorePatterns": ["node_modules/", ".expo/", "dist/", "babel.config.js"]
}
