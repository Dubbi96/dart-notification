{
  "expo": {
    "name": "공시온",
    "slug": "dart-alert",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "gongsion",
    "updates": {
      "url": "https://u.expo.dev/2807bcb5-05c4-479f-b3be-2b40686cc7ed"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gongsion.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14B8A6",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.gongsion.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 2,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#14B8A6"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14B8A6",
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#060A18",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2807bcb5-05c4-479f-b3be-2b40686cc7ed"
      }
    },
    "owner": "duvbi"
  }
}
