{
  "name": "mobile",
  "version": "1.0.2",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:lan": "bash scripts/start-lan.sh",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit",
    "quality:checks": "tsx scripts/run-quality-checks.ts",
    "release:check": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run quality:checks && npm run bundle:android",
    "e2e:smoke": "maestro test .maestro/",
    "bundle:android": "expo export --platform android --output-dir dist-ci",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json}\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.18.1",
    "babel-preset-expo": "~56.0.0",
    "date-fns": "^4.1.0",
    "expo": "~56.0.18",
    "expo-auth-session": "~56.0.16",
    "expo-blur": "~56.0.4",
    "expo-constants": "~56.0.16",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.16",
    "expo-notifications": "~56.0.22",
    "expo-router": "~56.2.17",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.23",
    "expo-web-browser": "~56.0.6",
    "phosphor-react-native": "^2.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.72.1",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-paper": "^5.15.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.85.0",
    "@testing-library/react-native": "~13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "prettier": "^3.8.2",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "private": true
