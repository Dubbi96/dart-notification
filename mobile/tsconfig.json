{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@components": ["components"],
      "@components/*": ["components/*"],
      "@theme": ["theme"],
      "@theme/*": ["theme/*"],
      "@hooks": ["hooks"],
      "@hooks/*": ["hooks/*"],
      "@services": ["services"],
      "@services/*": ["services/*"],
      "@stores": ["stores"],
      "@stores/*": ["stores/*"],
      "@app-types": ["types"],
      "@app-types/*": ["types/*"],
      "@utils": ["utils"],
      "@utils/*": ["utils/*"]
    }
  }
}
